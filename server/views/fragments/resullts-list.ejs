<div class="results-list-overlay overlay-model">
  <header class="list-header">
    <h3 class="label">
      <i class="bi bi-people-fill"></i>
      <%= t("quizzes:results_overlay.title") %>
    </h3>
    <div class="quiz-title">
      <span class="title-label"><%= t("quizzes:results_overlay.quiz_title_label") %></span>
      <h3 class="quiz-title"><%= quizTitle %></h3>
    </div>
    <!-- close btn -->
    <button type="button" class="close-results-overlay-btn exclude-btn">
      <i class="bi bi-x-lg"></i>
    </button>
  </header>
  <div class="table-div">
    <table>
      <thead>
        <tr>
          <th>
            <div>
              <i class="bi bi-person-circle"></i>
              <%= t("quizzes:results_overlay.table.profile") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-person"></i>
              <%= t("quizzes:results_overlay.table.full_name") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-calendar-event"></i>
              <%= t("quizzes:results_overlay.table.submitted_at") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-list-ol"></i>
              <%= t("quizzes:results_overlay.table.answered_questions") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-bar-chart-line"></i>
              <%= t("quizzes:results_overlay.table.score") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-gear"></i>
              <%= t("quizzes:results_overlay.table.actions") %>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <% results.forEach(result => { %>
        <tr>
          <td>
            <div class="avatar-cover">
              <% if (result.user.photoURL) { %>
              <img src="<%= result.user.photoURL %>" alt="avatar" width="32" height="32"/>
              <% } else { %>
              <h4><%= result.user.fullName.charAt(0).toUpperCase() %></h4>
              <% } %>
            </div>
          </td>
          <td><%= result.user.fullName %></td>
          <td><%= result.resultDetails.submittedAt %></td>
          <td><%= result.resultDetails.submittedCount %></td>
          <td class="<%= getScoreClass(result.score) %>">
            <%= result.score %>
          </td>
          <td>
            <button
              class="small-btn show-result-btn"
              data-user-id="<%= result.resultDetails.userId %>"
            >
              <i class="bi bi-eye"></i>
              <%= t("quizzes:actions.view_result") %>
            </button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
