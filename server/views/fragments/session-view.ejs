<div class="overlay-model session-view-overlay" data-id="<%= session.id %>">
  <header>
    <h3><%= t("quizzes:session_overlay.title") %></h3>
    <button type="button" class="exclude-btn close-session-view-overlay should-fill">
      <i class="bi bi-x-circle"></i>
    </button>
  </header>
  <div class="session-overlay-content">
    <div class="overlay-top">
      <div class="group-name-wrapper">
        <span class="badge blue-badge">
          <i class="bi bi-book-fill"></i>
          <%= session.groupName %>
        </span>
      </div>
      <div>
        <h3 class="session-name"><%= session.name %><span class="badge simple-badge users-count"><%= t("quizzes:plural_counts.joined_users", { count: session.joinedCount }) %></span></h3>
        
      </div>
      <p class="session-description"><%= session.description %></p>
      <div class="session-info">
        <span class="badge green-badge start-badge">
          <%= t("quizzes:session_overlay.started", { time: session.startTime }) %>
        </span>
        <span class="badge orange-badge end-badge">
          <%= t("quizzes:session_overlay.ends", { time: session.endTime }) %>
        </span>
        <span class="badge blue-badge duration-badge">
          <%= t("quizzes:session_overlay.duration", { time: session.duration }) %>
        </span>
      </div>
    </div>
    <% if (session.quiz) { %>
    <div class="quiz">
      <h3>
        <i class="bi bi-clipboard2-check-fill"></i>
        <%= t("quizzes:session_overlay.session_quiz") %>
      </h3>
      <div class="quiz-info">
        <h3 class="quiz-title"><%= session.quiz.title %></h3>
        <span class="questions-count badge blue-badge">
          <%= session.quiz.questionsCount %>
          <span><%= t("quizzes:labels.questions") %></span>
        </span>
        <span class="start-time badge<%= session.quiz.status === 'Finished' ? ' gray-badge' : session.quiz.status === 'active' ? ' green-badge' : ' orange-badge'%>">
          <i class="bi bi-clock-fill"></i>
          <%= session.quiz.status.slice(0, 1).toUpperCase() +  session.quiz.status.slice(1)  %>
        </span>
      </div>
    </div>
    <% } %>
    <div class="session-tasks">
      <header>
        <h3 class="title"><i class="bi bi-ui-checks"></i><%= t("quizzes:session_overlay.tasks_heading") %></h3>
        <div class="btns">
          <button
            type="button"
            data-tooltip="<%= t('quizzes:session_overlay.scroll_to_top_tooltip') %>"
            class="exclude-btn scroll-to-top has-tooltip"
          >
            <i class="bi bi-arrow-up-short"></i>
          </button>
          <button
            type="button"
            data-tooltip="<%= t('quizzes:session_overlay.collapse_all_tooltip') %>"
            class="exclude-btn collapse-all has-tooltip"
          >
            <i class="bi bi-arrows-expand"></i>
          </button>
        </div>
      </header>
      <!-- ongoing tasks list is just for get the same style as in the active page -->
      <div class="tasks-list">
        <%_ session.tasks.map((task, index) => { %>
            <div class="task-wrapper ">
              <div <%- task instanceof Quiz 
              ? `data-tooltip="${t('quizzes:session_overlay.quiz_tooltip')}"` 
              : '' %> class="task-box<%= task instanceof Quiz ? ' has-tooltip quiz-task-box' : '' %>">
                <div class="counter">
                  <span>
                    <%= (index + 1) .toString()
                    .padStart(session.tasks.length.toString().length, '0') %>
                  </span>
                </div>
                <span class="title"><%= task.title %></span>
                <span class="duration"><%= session.millisecondsToHMFormat( task.durationInMins * 60 * 1000, t ) _%>
                </span>
                <div class="icons">
                  <button type="button" data-tooltip="<%= t('quizzes:session_overlay.show_details_tooltip') %>" class="task-down-icon exclude-btn should-fill has-tooltip">
                    <i class="bi bi-caret-down"></i>
                  </button>
                </div>
              </div>
              <div class="task-details">
                <h5><%= t("quizzes:session_overlay.task_title") %></h5>
                <p><%= task.title %></p>
                <h5><%= t("quizzes:session_overlay.task_details") %></h5>
                <%=task.description _%>
              </div>
            </div>
            <% }) %>
      </div>
    </div>
  </div>
  <button type="button" class="join-session blue-btn">
    <i class="bi bi-box-arrow-in-right"></i>
    <%= t("quizzes:session_overlay.join_session") %>
  </button>
</div>
