<div class="overlay-model add-member-overlay">
  <header class="list-header">
    <h3 class="label">
      <i class="bi bi-people-fill"></i>
      Add Members
    </h3>
    <!-- close btn -->
    <button type="button" class="close-results-overlay-btn exclude-btn">
      <i class="bi bi-x-lg"></i>
    </button>
  </header>
  <section class="text-helper">
    Enter the user’s ID or name to add them to the group
  </section>
  <section class="search-sec">
    <div class="members-search users-search">
      <div class="search-icon-container">
        <i class="bi bi-person-fill"></i>
      </div>

      <input
        type="search"
        id="search"
        placeholder="Search By Member Name or ID"
      />
    </div>
  </section>
  <section class="selected-members">
    <!-- <div class="member-badge badge simple-badge">
      <div class="avatar">
        <img
          src="https://randomuser.me/api/portraits/men/32.jpg"
          alt="Member Avatar"
        />
      </div>
      <span class="member-name">John Doe</span>
      <button class="remove-btn exclude-btn">
        <i class="bi bi-x"></i>
      </button>
    </div> -->
  </section>
  <span class="badge simple-badge results-count">13 Members Found</span>
  <section class="members-result">
    <label class="container member-item">
      <input type="checkbox" id="admin" value="Admin" />
      <svg viewBox="0 0 64 64" height="2em" width="2em">
        <path
          d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
          pathLength="575.0541381835938"
          class="path"
        ></path>
      </svg>
      <div class="avatar">
        <img
          src="https://randomuser.me/api/portraits/men/78.jpg"
          alt="Member Avatar"
        />
      </div>
      Michael Lee
    </label>
  </section>
  <div class="action-btns">
    <button type="button" class="btn blue-btn add-member-confirm-btn">
      Confirm
    </button>
    <button type="button" class="btn gray-btn close-results-overlay-btn">
      Cancel
    </button>
  </div>
</div>
