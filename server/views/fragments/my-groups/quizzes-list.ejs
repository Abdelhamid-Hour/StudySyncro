<div class="quizzes-view fade-in-template">
  <header>
    <div class="quizzes-search search">
      <div class="search-icon-container">
        <i class="bi bi-clipboard-check-fill"></i>
      </div>
      <label
        data-tooltip="<%= t('common:topbar.filter_date_tooltip') %>"
        class="date-label should-fill has-tooltip"
      >
        <i class="bi bi-calendar"></i>
        <input type="date" id="date-input" />
      </label>
      <input
        type="search"
        id="search"
        placeholder="<%= t('quizzes:labels.search_placeholder') %>"
        autocomplete="username"
      />
    </div>
    <label
      class="exclude-btn sort-button button has-tooltip"
      data-tooltip="<%= t('quizzes:labels.sort_quizzes') %>"
    >
      <i class="bi bi-sort-down"></i>
      <input type="checkbox" id="sort-checkbox" class="sort-checkbox" />
    </label>
  </header>
  <div data-last-visible="<%= lastVisible || '' %>" class="quizzes-list">
    <% if (quizzes && quizzes.length > 0) { %>
    <% quizzes.forEach( (quiz) => { %>
    <div class="quiz-card card-item" data-quiz-id="<%= quiz.quizId %>">
      <div class="quiz-title-container info-container">
        <label class="quiz-title-label">
          <span class="icon-box">
            <i class="bi bi-question-circle"></i>
          </span>
          <%= t("common:shared_terms.quiz_title") %>
        </label>
        <div class="quiz-title content"><bdi><%= quiz.title %></bdi></div>
      </div>
      <div class="session-name-container info-container">
        <label class="session-name-label">
          <span class="icon-box">
            <i class="bi bi-clock-history"></i>
            <i class="bi bi-info-circle"></i>
          </span>
          <%= t("quizzes:labels.session_name") %>
        </label>
        <div class="session-name content"><bdi><%= quiz.sessionName || 'N/A' %></bdi></div>
      </div>
      <div class="questions-container info-container small-container">
        <label class="questions-label">
          <span class="icon-box">
            <i class="bi bi-question-circle"></i>
          </span>
          <%= t("common:shared_terms.questions") %>
        </label>
        <div class="questions content">
          <span><bdi><%= quiz.questionsCount %></bdi></span>
        </div>
      </div>
      <div class="quiz-date-container info-container small-container">
        <label class="quiz-date-label">
          <span class="icon-box">
            <i class="bi bi-calendar-event"></i>
          </span>
          <%= t("common:shared_terms.submitted_at") %> <% if (!quiz.submittedAt) { %>
          <!-- info icon -->
          <i
            style="margin-inline-start: auto;"
            class="bi bi-info-circle has-tooltip"
            data-tooltip="<%= isAdmin ? t('quizzes:labels.admin_cant_submit') : t('quizzes:labels.not_submitted_tooltip') %>"
          ></i>
          <% } %>
        </label>
        <div class="quiz-date content">
          <span><bdi><%= quiz.submittedAt ? quiz.submittedAt : 'N/A' %></bdi></span>
        </div>
      </div>
      <% if (quiz.passed || isAdmin) { %>
       <div class="action-btns">
        <button
          type="button"
          class="view-result<% if(isAdmin) { %>s<% } %>-btn should-fill"
        >
          <i class="bi bi-eye"></i>
          <%= isAdmin ? t("common:shared_terms.view_results") : t("common:shared_terms.view_result") %>
        </button>
        <% if (!isAdmin) { %>
        <button type="button" class="retake-btn">
          <i class="bi bi-arrow-repeat"></i>
          <%= t("quizzes:actions.retake") %>
        </button>
        <% } %>
      </div>
      <% } %>
    </div>
    <% }); %>
    <% } else { %>
    <div class="icon-wrapper">
      <div class="empty-icon-container">
        <i class="bi bi-clipboard-x"></i>
      </div>
      <h3><%= t("groups:quizzes_list.empty_heading") %></h3>
      <p><%= t("groups:quizzes_list.empty_desc") %></p>
    </div>
    <% } %>
  </div>
</div>
