<div class="session-info fade-in-template">
  <!-- Session Name -->
  <div class="session-name-info-box info-box">
    <div class="session-name-container info-container">
      <span class="label">
        <span class="session-info-icon icon-box">
          <i class="bi bi-clock-history"></i>
        </span>
        <%= t("quizzes:labels.session_name") %>
      </span>
      <span class="session-name-value value content"><bdi><%= name %></bdi></span>
    </div>
  </div>

  <!-- Description -->
  <div class="session-description-info-box info-box">
    <div class="session-description-container info-container">
      <span class="label">
        <span class="session-description-icon icon-box">
          <i class="bi bi-journal-text"></i>
        </span>
        <%= t("common:shared_texts.description") %>
      </span>
      <p
        class="session-description-value value has-tooltip"
        data-tooltip="<%= description %>"
      >
        <bdi><%= description %></bdi>
      </p>
    </div>
  </div>

  <div class="quiz-info-box info-box">
    <div class="quiz-container info-container">
      <span class="label">
        <span class="quiz-icon icon-box">
          <i class="bi bi-question-circle"></i>
        </span>
        <%= t("common:shared_terms.quiz") %>
      </span>
      <span class="quiz-value value content"><bdi><%= quiz ? quiz.title : t("groups:session_info.no_quiz") %></bdi></span>
    </div>
  </div>

  <!-- Timing Metrics -->
  <div class="timing-metrics dual-box">
    <div class="start-info-box info-box">
      <div class="start-container info-container">
        <span class="label">
          <span class="start-icon icon-box">
            <i class="bi bi-play-circle"></i>
          </span>
          <%= t("common:shared_terms.start") %>
        </span>
        <span class="start-value value content"><bdi><%= startTime %></bdi></span>
      </div>
    </div>
    <div class="end-info-box info-box">
      <div class="end-container info-container">
        <span class="label">
          <span class="end-icon icon-box">
            <i class="bi bi-stopwatch"></i>
          </span>
          <%= t("common:shared_terms.end") %>
        </span>
        <span class="end-value value content"><bdi><%= endTime %></bdi></span>
      </div>
    </div>
  </div>

  <div class="timing-metrics dual-box">
    <div class="duration-info-box info-box">
      <div class="duration-container info-container">
        <span class="label">
          <span class="duration-icon icon-box">
            <i class="bi bi-clock"></i>
          </span>
          <%= t("common:shared_terms.duration") %>
        </span>
        <span class="duration-value value content">
          <bdi><%= duration %></bdi>
        </span>
      </div>
    </div>
    <div class="joined-count-info-box info-box">
      <div class="joined-count-container info-container">
        <span class="label">
          <span class="joined-count-icon icon-box">
            <i class="bi bi-people-fill"></i>
          </span>
          <%= t("common:shared_terms.joined_count") %>
        </span>
        <span class="joined-count-value value content">
          <%= t("groups:plural_counts.members", { count: joinedCount }) %>
        </span>
      </div>
    </div>
  </div>
  <div class="session-tasks info-box">
    <div class="info-container">
    <span class="label">
      <span class="joined-count-icon icon-box">
        <i class="bi bi-ui-checks"></i>
      </span>
      <%= t("common:mobile_nav.tasks") %>
      <div class="action-btns">
        <button
          type="button"
          data-tooltip="<%= t('quizzes:session_overlay.scroll_to_top_tooltip') %>"
          class="exclude-btn scroll-to-top has-tooltip tasks-btn action-btn"
        >
          <i class="bi bi-arrow-up-short"></i>
        </button>
        <button
          type="button"
          data-tooltip="<%= t('quizzes:session_overlay.collapse_all_tooltip') %>"
          class="exclude-btn collapse-all has-tooltip tasks-btn action-btn"
        >
          <i class="bi bi-arrows-expand"></i>
        </button>
      </div>
    </span>
    <!-- ongoing tasks list is just for get the same style as in the active page -->
    <div class="tasks-list">
      <%_ tasks.map((task, index) => { %>
          <div class="task-wrapper">
            <div <%- task.isQuiz
            ? `data-tooltip="${t('common:shared_terms.quiz')}"` 
            : '' %> class="task-box<%= task.isQuiz ? ' has-tooltip quiz-task-box' : '' %>">
              <div class="counter">
                <span>
                  <bdi><%= (index + 1) .toString()
                  .padStart(tasks.length.toString().length, '0') %></bdi>
                </span>
              </div>
              <span class="title"><bdi><%= task.title %></bdi></span>
              <span class="duration"><bdi><%= millisecondsToHMFormat( task.durationInMins * 60 * 1000, t ) _%></bdi>
              </span>
              <div class="icons">
                <button type="button" data-tooltip="<%= t('quizzes:session_overlay.show_details_tooltip') %>" class="task-down-icon exclude-btn should-fill has-tooltip">
                  <i class="bi bi-caret-down"></i>
                </button>
              </div>
            </div>
            <div class="task-details">
              <h5><%= t("quizzes:session_overlay.task_title") %></h5>
              <p><bdi><%= task.title %></bdi></p>
              <h5><%= t("quizzes:session_overlay.task_details") %></h5>
              <%=task.description _%>
            </div>
          </div>
          <% }) %>
      </div>
    </div>
  </div>
  <div class="action-btns">
    <% if (isJoined) { %>
    <button data-session-id="<%= id %>" type="button" class="<%= isAdmin ? 'end' : 'leave' %>-btn red-btn should-fill">
      <i class="bi bi-x-circle"></i>
      <%= isAdmin ? t("common:shared_terms.end_session") : t("common:shared_terms.leave_session") %>
    </button>
    <% } else { %>
    <button data-session-id="<%= id %>" type="button" class="green-btn join-btn should-fill blue-btn">
      <i class="bi bi-check-circle"></i>
      <%= t("common:shared_terms.join_session") %>
    </button>
    <% } %>
  </div>
</div>

