<div class="results-list-overlay overlay-model">
  <header class="list-header">
    <h3 class="label">
      <i class="bi bi-people-fill"></i>
      <%= t("quizzes:results_overlay.title") %>
    </h3>
    <div class="quiz-title">
      <span class="title-label"><%= t("quizzes:results_overlay.quiz_title_label") %></span>
      <h3 class="quiz-title"><%= quizTitle %></h3>
    </div>
    <!-- close btn -->
    <button type="button" class="close-results-overlay-btn exclude-btn">
      <i class="bi bi-x-lg"></i>
    </button>
  </header>
  
  <div class="users-search header-container" style="width: 100%;">
    <div class="search-icon-container">
      <i class="bi bi-search"></i>
    </div>
    <input type="search" class="results-search-input" placeholder="<%= t('groups:members_list.search_placeholder') %>" id="search">
  </div>

  <% if (cards.length > 0) { %>
  <div class="table-div">
    <table>
      <thead>
        <tr>
          <th>
            <div>
              <i class="bi bi-person-circle"></i>
              <%= t("quizzes:results_overlay.table.profile") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-person"></i>
              <%= t("common:shared_terms.full_name") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-calendar-event"></i>
              <%= t("common:shared_terms.submitted_at") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-list-ol"></i>
              <%= t("quizzes:results_overlay.table.answered_questions") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-bar-chart-line"></i>
              <%= t("common:shared_terms.score") %>
            </div>
          </th>
          <th>
            <div>
              <i class="bi bi-gear"></i>
              <%= t("quizzes:results_overlay.table.actions") %>
            </div>
          </th>
        </tr>
      </thead>
      <tbody class="results-list" data-last-visible="<%= lastVisible || '' %>">
        <% cards.forEach(result => { %>
        <tr class="card-item">
          <td data-label="<%= t('quizzes:results_overlay.table.profile') %>">
            <div class="avatar-cover">
              <% if (result.user.photoURL) { %>
              <img src="<%= result.user.photoURL %>" alt="" width="32" height="32"/>
              <% } else { %>
              <h4><%= result.user.fullName.charAt(0).toUpperCase() %></h4>
              <% } %>
            </div>
          </td>
          <td data-label="<%= t('common:shared_terms.full_name') %>"><%= result.user.fullName %></td>
          <td data-label="<%= t('common:shared_terms.submitted_at') %>"><%= result.resultDetails.submittedAt %></td>
          <td data-label="<%= t('quizzes:results_overlay.table.answered_questions') %>"><%= result.resultDetails.submittedCount %></td>
          <td data-label="<%= t('common:shared_terms.score') %>" class="<%= getScoreClass(result.score) %>">
            <%= result.score %>
          </td>
          <td data-label="<%= t('quizzes:results_overlay.table.actions') %>">
            <button
              class="small-btn show-result-btn"
              data-user-id="<%= result.resultDetails.userId %>"
            >
              <i class="bi bi-eye"></i>
              <%= t("common:shared_terms.view_result") %>
            </button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="icon-wrapper">
    <div class="empty-icon-container">
      <i class="bi bi-bar-chart-line"></i>
    </div>
    <h3><bdi><%= t("quizzes:results_overlay.no_results") %></bdi></h3>
    <p><bdi><%= t("quizzes:results_overlay.no_results_description") %></bdi></p>
  </div>
  <% } %>
</div>

