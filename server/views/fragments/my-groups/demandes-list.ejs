<div class="members-view demandes-view">
  <header>
    <div class="users-search demandes-search search">
      <div class="search-icon-container">
        <i class="bi bi-person-fill"></i>
      </div>
      <label
        data-tooltip="<%= t('common:topbar.filter_date_tooltip') %>"
        class="date-label should-fill has-tooltip"
      >
        <i class="bi bi-calendar"></i>
        <input type="date" id="date-input" />
      </label>
      <input
        type="search"
        id="search"
        placeholder="<%= t('groups:demandes.search_placeholder') %>"
        autocomplete="username"
      />
    </div>
    <label class="exclude-btn sort-button button has-tooltip" data-tooltip="<%= t('groups:demandes.sort_tooltip') %>">
      <i class="bi bi-sort-down"></i>
      <input type="checkbox" id="sort-checkbox" class="sort-checkbox" />
    </label>
  </header>
  <div data-last-visible="<%= lastVisible || '' %>" class="demandes-list">
    <% if (requests && requests.length > 0) { %>
    <% requests.forEach((demande) => { %>
    <div class="demande card-item">
      <div class="avatar">
        <% if (demande.photoURL) { %>
        <img src="<%= demande.photoURL %>" alt="" />
        <% } else { %>
        <h4><bdi><%= demande.fullName.charAt(0).toUpperCase() %></bdi></h4>
        <% } %>
      </div>
      <div class="username-container">
        <span class="username"><bdi><%= demande.fullName %></bdi></span>
        <span class="request-date"><bdi><%= demande.demandeDate %></bdi></span>
      </div>
      <div class="action-btns" data-user-id="<%= demande.userId %>">
        <button type="button" class="red-btn reject-btn small-btn">
          <i class="bi bi-x-circle"></i>
          <%= t("common:notifications_drawer.actions.reject") %>
        </button>
        <button type="button" class="green-btn accept-btn small-btn">
          <i class="bi bi-check-circle"></i>
          <%= t("common:notifications_drawer.actions.accept") %>
        </button>
      </div>
    </div>
    <% }); %>
    <% } else { %>
    <div class="icon-wrapper">
      <div class="empty-icon-container">
        <i class="bi bi-person-check"></i>
      </div>
      <h3><%= t("groups:demandes.empty_heading") %></h3>
      <p><%= t("groups:demandes.empty_desc") %></p>
    </div>
    <% } %>
  </div>
</div>

