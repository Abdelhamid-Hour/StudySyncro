<div class="members-view">
  <header>
    <div class="members-search users-search">
      <div class="search-icon-container">
        <i class="bi bi-person-fill"></i>
      </div>
      <input
        type="search"
        id="search"
        placeholder="<%= t('groups:members_list.search_placeholder') %>"
      />
    </div>
    <% if(isAdmin) { %>
    <button type="button" class="invite-user-btn">
      <i class="bi bi-plus-lg"></i>
      <%= t("groups:members_list.invite") %>
    </button>
    <% } %>
  </header>
  <div data-last-visible="<%= lastVisible || '' %>" class="members-list">
    <% members.forEach((member) => { %>
    <div class="member card-item">
      <div class="avatar">
        <% if (member.photoURL) { %>
        <img src="<%= member.photoURL %>" alt="" />
        <% } else { %>
        <h4><bdi><%= member.fullName.charAt(0).toUpperCase() %></bdi></h4>
        <% } %>
      </div>
      <span class="username"><bdi><%= member.fullName %></bdi></span>
      <% if (member.isAdmin) { %>
        <span class="badge orange-badge" style="margin-inline-end: auto;"><%= t("groups:badges.host") %></span>
      <% } %>
      <% if (isAdmin && !member.isAdmin) { %>
      <div class="action-btns" data-member-id="<%= member.id %>">
        <button type="button" class="red-btn kick-btn small-btn">
          <i class="bi bi-person-dash"></i>
          <%= t("groups:members_list.kick") %>
        </button>
        <button type="button" class="orange-btn move-admin-role-btn small-btn">
          <i class="bi bi-person-gear"></i>
          <%= t("groups:members_list.transfer_admin") %>
        </button>
      </div>
      <% } %>
    </div>
    <% }); %>
  </div>
</div>

