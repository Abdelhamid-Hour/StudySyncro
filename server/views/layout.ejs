<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script>
      (function() {
        try {
          var theme = localStorage.getItem("theme") || "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch(e) {}
      })();
    </script>
    
    <!-- Preloading Critical Resources -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
    <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap"
    as="style"
    id="font-arabic-preload"
    />
    <% } %>
    <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    as="style"
    id="font-inter-preload"
    />
    <link
    rel="preload"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      as="style"
      />
    <link rel="preload" href="/app/assets/global/css/styles.css" as="style" />
    <link
    data-dynamic=""
    rel="preload"
    href="/app/assets<%- resourcesRoute %>css/styles.css"
    as="style"
    />
    <link rel="preload" href="/main_assets/css/styles.css" as="style" />
    <link
    rel="preload"
    href="/main_assets/css/variables_and_fonts.css"
    as="style"
    />
    <link
    rel="modulepreload"
    href="/app/assets/global/js/main.js"
    as="script"
    crossorigin="anonymous"
    />
    <link
    data-dynamic=""
    rel="modulepreload"
    href="/app/assets<%- resourcesRoute %>js/main.js"
    as="script"
    crossorigin="anonymous"
    />
    <% sharedStyles?.forEach(style => { %>
      <%- style.styleTag %>
      <%- style.preloadLink %>
    <% }) %>
      <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap"
        id="font-arabic"
      />
      <% } %>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        id="font-inter"
      />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <link rel="stylesheet" href="/app/assets/global/css/styles.css" />
    <link data-dynamic="" rel="stylesheet" href="/app/assets<%- resourcesRoute %>css/styles.css" />
    <link rel="stylesheet" href="/main_assets/css/styles.css" />
    <link rel="stylesheet" href="/main_assets/css/variables_and_fonts.css" />
    <title>StudyHype — <%= resourcesRoute.includes("/home/") 
      ? t("common:titles.home") 
      : resourcesRoute === '/groups/my/group-chat/' 
      ? t("common:titles.group_chat") 
      : resourcesRoute === '/groups/available/'
      ? t("common:titles.available_groups")
      : ['/groups/my/', '/groups/available/'].includes(resourcesRoute) || resourcesRoute.includes('/groups/')
      ? t("common:titles.groups") 
      : resourcesRoute === '/quizzes/my/quiz-editor/' 
      ? t("common:titles.quiz_editor") 
      : resourcesRoute === '/quizzes/passed/'
      ? t("common:titles.passed_quizzes")
      : ['/quizzes/my/', '/quizzes/passed/'].includes(resourcesRoute) || resourcesRoute.includes('/quizzes/')
      ? t("common:titles.quizzes") 
      : resourcesRoute.includes('/settings/') 
      ? t("common:titles.settings") 
      : t("common:titles.dashboard") %></title>
  </head>
  
  <body>
    <aside class="top-side-bar">
      <div class="top-sidebar-header">
        <h2 class="sidebar-title">
          <%- resourcesRoute.includes("/home/") 
            ? t("common:titles.home") 
            : ['/groups/my/', '/groups/available/'].includes(resourcesRoute) 
            ? t("common:titles.groups") 
            : ['/quizzes/my/', '/quizzes/passed/'].includes(resourcesRoute) 
            ? t("common:titles.quizzes") 
            : resourcesRoute === '/groups/my/group-chat/' 
            ? `<a href="/app/groups/my" class="route-link"><i class="bi bi-caret-left-fill"></i>${t("common:titles.group_chat")}</a>`
            : resourcesRoute === '/quizzes/my/quiz-editor/' 
            ? `<a href="/app/quizzes/my" class="route-link"><i class="bi bi-caret-left-fill"></i>${t("common:titles.quiz_editor")}</a>`
            : resourcesRoute.includes('/settings/')
            ? t("common:titles.settings")
            : '' %>
        </h2>
        <% if (['/groups/my/', '/groups/available/', '/quizzes/my/', '/quizzes/passed/'].includes(resourcesRoute)) { %>
        <div class="navigation-tabs <%= resourcesRoute.includes('/quizzes/') ? 'quizzes-tabs' : 'groups-tabs' _%>">
          <a
            href="/app<%= resourcesRoute.includes('/quizzes/') ? '/quizzes' : '/groups' _%>/my"
            class="tab route-link <% if (resourcesRoute === "/groups/my/" || resourcesRoute === "/quizzes/my/") { %> active-tab<% } %> exclude-btn"
          >
            <%= resourcesRoute.includes('/quizzes/') ? t("common:topbar.tabs.my_quizzes") : t("common:topbar.tabs.my_groups") %>
          </a>
          <a
            href="/app<%= resourcesRoute.includes('/quizzes/') ? '/quizzes/passed' : '/groups/available' _%>"
            class="tab route-link <%= resourcesRoute.includes('/quizzes/') ? 'groups-quizzes-tab' : 'available-groups-tab' %> <% if (resourcesRoute === "/groups/available/" || resourcesRoute === "/quizzes/passed/") { %> active-tab<% } %> exclude-btn"
          >
            <%= resourcesRoute.includes('/quizzes/') ? t("common:topbar.tabs.passed_quizzes") : t("common:titles.available_groups") %>
          </a>
        </div>
        <% } %>
      </div>
      <div class="top-side-bar-middele">
      <% if (resourcesRoute.includes("/home/")) { %>
      <div class="greeting-msg fade-in-template">
        <h2><%= t("common:topbar.greeting_hello", { fullName: user.fullName }) %></h2>
        <p><%= t("common:topbar.greeting_sub") %></p>
      </div>
      <% } else if (['/quizzes/my/', '/quizzes/passed/', '/groups/my/', '/groups/available/'].includes(resourcesRoute)) { %>
      <div class="search-container fade-in-template">
        <div class="main-search search">
          <div class="search-icon-container">
            <i class="bi bi-search"></i>
          </div>
          <input type="search" id="search-input" placeholder="<%- resourcesRoute.includes('/quizzes/my') ? t('common:topbar.search_placeholder_quizzes') : resourcesRoute.includes('/quizzes/passed') ? t('common:topbar.search_placeholder_passed') : t('common:topbar.search_placeholder_groups') %>" />
          <% if (resourcesRoute.includes('/quizzes/passed')) { %>
            <label data-tooltip="<%= t('common:topbar.filter_date_tooltip') %>" class="date-label should-fill has-tooltip">
              <i class="bi bi-calendar"></i>
              <input type="date" id="date-input">
            </label>
          <% } %> 
        </div>
        <!-- ? Filters -->
        <label type="button" class="exclude-btn sort-button button">
          <i class="bi bi-sort-down"></i>
          <input type="checkbox" id="sort-checkbox" class="sort-checkbox" />
        </label>
        <% if (resourcesRoute.includes('/groups/') || resourcesRoute.includes('/quizzes/my')) { %>
        <div class="filter-container">
          <button type="button" class="exclude-btn filter-button open-drop-down-btn should-fill">
            <i class="bi bi-funnel"></i>
          </button>
            <div  class="filter-panel overlay">
            <% if (resourcesRoute.includes('/groups/')) { %>
              <% if (resourcesRoute === '/groups/my/') { %>
                <!-- ? Role Filter -->
                <section class="filter-section">
                <h4 class="filter-title"><%= t("common:filters.role") %></h4>
                <div class="filter-option">
                <!-- From Uiverse.io by SelfMadeSystem --> 
                <label for="admin" class="container">
                <input type="checkbox" id="admin" value="Admin" />
                <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                </svg>
                <i class="bi bi-person-gear"></i>
                <%= t("common:filters.admin") %>
                </label>
                </div>
                <div class="filter-option">
                <label for="member" class="container">
                <input type="checkbox" id="member" value="Member" />
                <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                </svg>
                <i class="bi bi-person"></i>
                <%= t("common:filters.member") %>
                </label>
                </div>
                </section>
                <% } %>
                <!-- ? Visibility Filter -->
                <section class="filter-section">
                <h4 class="filter-title"><%= t("common:filters.visibility") %></h4>
                <div class="filter-option">
                <label for="private" class="container">
                <input type="checkbox" id="private" value="Private" />
                <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                </svg>
                <i class="bi bi-lock"></i>
                <%= t("common:filters.private") %>
                </label>
                </div>
                <div class="filter-option">
                <label for="public" class="container">
                <input type="checkbox" id="public" value="Public" />
                <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                </svg>
                <i class="bi bi-eye"></i>
                <%= t("common:filters.public") %>
                </label>
                </div>
                </section>
                <!-- ? Level Filter -->
                <section class="filter-section">
                <h4 class="filter-title"><%= t("common:filters.level") %></h4>
                <div class="filter-option">
                <label for="advanced" class="container">
                  <input type="checkbox" id="advanced" value="Advanced" />
                  <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                  </svg>
                  <i class="bi bi-graph-up"></i>
                  <%= t("common:filters.advanced") %>
                </label>
                </div>
                <div class="filter-option">
                <label for="intermediate" class="container">
                  <input type="checkbox" id="intermediate" value="Intermediate" />
                  <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                  </svg>
                  <i class="bi bi-bar-chart"></i>
                  <%= t("common:filters.intermediate") %>
                </label>
                </div>
                <div class="filter-option">
                <label for="beginner" class="container">
                  <input type="checkbox" id="beginner" value="Beginner" />
                  <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                  </svg>
                  <i class="bi bi-lightbulb"></i>
                  <%= t("common:filters.beginner") %>
                </label>
                </div>
                </section>
                <!-- ? View Options -->
                <% if (resourcesRoute === '/groups/available/') { %>
                <section class="filter-section">
                <h4 class="filter-title"><%= t("common:filters.view_options") %></h4>
                <div class="filter-option">
                <label for="joinable-only" class="container">
                  <input type="checkbox" id="joinable-only" value="Joinable Only" />
                  <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                  </svg>
                  <i class="bi bi-people"></i>
                  <%= t("common:filters.joinable_only") %>
                </label>
                </div>
                </section>
                <% } %>
              <% } %>
                <% if (resourcesRoute.includes('/quizzes/my')) { %>
                 <!-- ? Status Filter -->
                <section class="filter-section">
                <h4 class="filter-title"><%= t("common:filters.status") %></h4>
                <div class="filter-option">
                <label for="published" class="container">
                <input type="checkbox" id="published" value="published" />
                <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                </svg>
                <i class="bi bi-check-circle"></i>
                <%= t("common:filters.published") %>
                </label>
                </div>
                <div class="filter-option">
                <label for="draft" class="container">
                <input type="checkbox" id="draft" value="draft" />
                <svg viewBox="0 0 64 64" height="2em" width="2em">
                  <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                  ></path>
                </svg>
                <i class="bi bi-pencil"></i>
                <%= t("common:filters.draft") %>
                </label>
                </div>

                </section>
                <% } %>
            </div>
        </div>  
        <% } %>
      </div>
      <% } else if (resourcesRoute === '/groups/my/group-chat/') { %>
        <h1 class="fade-in-template"><%= groupName %></h1>
      <% } else if (resourcesRoute === '/quizzes/my/quiz-editor/') { %>
        <h1 class="fade-in-template"><%= quizTitle %></h1>
      <% } %>
      </div>
      <div class="top-side-bar-footer">
        <% if (resourcesRoute === '/groups/my/') { %>
        <button type="button" class="create-group-btn">
          <i class="bi bi-plus-circle"></i>
          <span><%= t("common:actions.create_group") %></span>
        </button>
        <% } else if (resourcesRoute === '/quizzes/my/quiz-editor/') { %>
        <button type="button" class="save-quiz-btn should-fill blue-btn">
          <i class="bi bi-floppy"></i>
          <span><%= t("common:actions.save") %></span>
        </button>
        <% } else if (resourcesRoute === '/quizzes/my/') { %>
        <button type="button" class="create-quiz-btn">
          <i class="bi bi-plus-circle"></i>
          <span><%= t("common:actions.create_quiz") %></span>
        </button>
        <% } %>

        <div class="profile-container">
          <button type="button" class="profile-btn open-drop-down-btn exclude-btn should-fill">
            <div class="avatar">
              <% if (user.photoURL) { %>
                <img
                  src="<%= user.photoURL %>"
                  alt="avatar"
                />
              <% } else { %>
                <h4><%= user.fullName.charAt(0).toUpperCase() %></h4>
              <% } %>
            </div>
            <div class="profile-info">
              <span><%= user.fullName %></span>
              <span><%= user.email %></span>
            </div>
            <i class="bi bi-caret-down drop-down-icon"></i>
          </button>
          <ul class="profile-drop-down-menu overlay">
            <li class="account should-fill">
              <a href="/app/settings" class="drop-down-item route-link">
                <i class="bi bi-person"></i>
                <%= t("common:profile_menu.account") %>
              </a>
            </li>
            <li class="groups should-fill">
              <a href="/app/groups/my" class="drop-down-item route-link">
                <i class="bi bi-people"></i>
                <%= t("common:topbar.tabs.my_groups") %>
              </a>
            </li>
            <li class="quizzes should-fill">
              <a href="/app/quizzes/my" class="drop-down-item route-link">
                <i class="bi bi-clipboard-check"></i>
                <%= t("common:topbar.tabs.my_quizzes") %>
              </a>
            </li>
            <li class="logout-button-li account">
              <button type="button" id="logout-button" class="red-btn drop-down-item">
                <i class="bi bi-box-arrow-in-left"></i>
                <%= t("common:profile_menu.logout") %>
              </button>
            </li>
          </ul>
        </div>
      </div>
    </aside>
    <aside class="left-side-bar">
      <div class="logo-container">
        <img src="/main_assets/images/logo-mark.svg" alt="StudyHype Logo" style="aspect-ratio: 1 / 1; width: 2.2rem; flex-shrink: 0;" />
        <h6 class="should-hide">StudyHype</h6>
      </div>
      <div class="side-bar-icons">
        <div class="top-side-bar-icons">
          <a href="/app/home" class="nav-link route-link should-fill<% if (resourcesRoute.includes("/home/")) { %> active<% } %> ">
            <i class="bi bi-house<%_ if (resourcesRoute.includes("/home/")) { %>-fill<% } %>"></i>
            <h3 class="should-hide"><%= t("common:sidebar.overview") %></h3>
          </a>
          <a
            href="/app/groups/my"
            class="nav-link route-link should-fill<% if (resourcesRoute.includes("/groups/")) { %> active<% } %>"
          >
            <i class="bi bi-people<%_ if (resourcesRoute.includes("/groups/")) { %>-fill<% } %>"></i>
            <h3 class="should-hide"><%= t("common:titles.groups") %></h3>
          </a>
          <a href="/app/quizzes/my" class="nav-link route-link should-fill<% if (resourcesRoute.includes("/quizzes/")) { %> active<% } %>">
            <i class="bi bi-clipboard-check<% if (resourcesRoute.includes("/quizzes/")) { %>-fill<% } %>"></i>
            <h3 class="should-hide"><%= t("common:titles.quizzes") %></h3>
          </a>
        </div>
        <div class="bottom-side-bar-icons">
          <button type="button" style="padding-bottom: initial;" class="exclude-btn toggle-container nav-btn should-fill" title="<%= t('common:sidebar.theme_tooltip') %>">
            <i class="bi bi-moon theme-toggle-icon"></i>
          </button>
          <button type="button" class="exclude-btn lang-toggle-btn nav-btn should-fill" title="<%= t('common:sidebar.switch_language_tooltip') %>" style="font-weight: 700;">
            <span class="lang-toggle-text"><%= lang === 'ar' ? 'EN' : 'AR' %></span>
          </button>
          <div class="notification-container" style="position: relative; display: flex; align-items: center; width: fit-content;">
            <% const unreadCount = (typeof notificationsData !== 'undefined' && notificationsData.unreadCount) ? notificationsData.unreadCount : 0; %>
            <button
              type="button"
              class="exclude-btn notification-btn open-drop-down-btn should-fill nav-btn has-tooltip"
              data-tooltip="<%= t('common:notifications_drawer.title') %>"
              style="position: relative;"
            >
              <i class="bi bi-bell"></i>
              <span class="badge notification-badge <%= unreadCount > 0 ? '' : 'hidden' %>"><%= unreadCount > 99 ? '99+' : unreadCount %></span>
            </button>
          </div>
          <button type="button" class="exclude-btn open-close-side-bar-btn nav-btn" title="<%= t('common:sidebar.toggle_tooltip') %>">
            <i class="bi bi-layout-sidebar sidebar-toggle-icon"></i>
          </button>
          <a
            href="/app/settings"
            class="settings-container nav-link route-link should-fill<% if (resourcesRoute === "/settings/") { %> active<% } %>"
          >
            <i class="bi bi-gear<%_ if (resourcesRoute === "/settings/") { %>-fill<% } _%>"></i>
          </a>
        </div>
      </div>
    </aside>
    <script>
      if (localStorage.getItem("sidebar-collapsed") === "true") {
        document.querySelectorAll(".should-hide").forEach(function(el) {
          el.classList.add("hidden");
        });
      }
    </script>
    <div class="notifications-overlay overlay">
      <header class="notifications-header">
        <div class="header-title">
          <i class="bi bi-bell-fill"></i>
          <span><%= t("common:notifications_drawer.title") %></span>
        </div>

        <button type="button" class="exclude-btn close-overlay-btn">
          <i class="bi bi-x-lg"></i>
        </button>
      </header>
      <div class="notifications-categories">
        <button type="button" class="notif-category-btn exclude-btn active" data-category="All"><%= t("common:notifications_drawer.categories.all") %></button>
        <button type="button" class="notif-category-btn exclude-btn" data-category="Join Request"><%= t("common:notifications_drawer.categories.requests") %></button>
        <button type="button" class="notif-category-btn exclude-btn" data-category="Groups"><%= t("common:titles.groups") %></button>
        <button type="button" class="notif-category-btn exclude-btn" data-category="Sessions"><%= t("common:notifications_drawer.categories.sessions") %></button>
      </div>
      <div class="notifications-list" id="notifications-list" data-last-visible="<%= (typeof notificationsData !== 'undefined' && notificationsData.lastVisible) ? notificationsData.lastVisible : '' %>" data-current-session="<%= (typeof user !== 'undefined' && user && user.currentSession) ? user.currentSession : '' %>" data-current-user-id="<%= (typeof user !== 'undefined' && user && user.uid) ? user.uid : '' %>">
        <% if (typeof notificationsData !== 'undefined' && notificationsData.cards && notificationsData.cards.length > 0) { %>
          <%
            const formatNotifDate = (ts) => {
              try {
                const d = new Date(ts || Date.now());
                if (isNaN(d.getTime())) return "Recent";
                return d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
              } catch (e) {
                return "Recent";
              }
            };
            const escapeHtml = (str) => {
              if (typeof str !== 'string') return '';
              return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
            };
            const formatNotifMsg = (notif) => {
              let rawMsg = notif.message || "";
              if (notif.type && notif.metadata) {
                const template = t(`notifications:messages.${notif.type}.message`);
                if (template && !template.startsWith("notifications:messages.")) {
                  rawMsg = template.replace(/{(\w+)}/g, (_, match) => 
                    notif.metadata[match] !== undefined ? notif.metadata[match] : `{${match}}`
                  );
                }
              }

              let msg = escapeHtml(rawMsg);
              const adminRoleTerm = t("notifications:styling_terms.admin_role");
              if (adminRoleTerm && msg.includes(adminRoleTerm)) {
                msg = msg.replace(adminRoleTerm, `<strong>${adminRoleTerm}</strong>`);
              }
               const termsMap = [
                { term: t("notifications:styling_terms.invited_you_to_join"), cls: "bold-success" },
                { term: t("notifications:styling_terms.invited_you_to_join_suffix"), cls: "bold-success" },
                { term: t("notifications:styling_terms.successfully_joined"), cls: "bold-success" },
                { term: t("notifications:styling_terms.accepted"), cls: "bold-success" },
                { term: t("notifications:styling_terms.started"), cls: "bold-success" },
                { term: t("notifications:styling_terms.ended"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.rejected"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.declined"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.removed"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.deleted"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.demoted_from_admin"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.demoted"), cls: "bold-danger" },
                { term: t("notifications:styling_terms.pending_approval"), cls: "bold-warning" },
                { term: t("notifications:styling_terms.transferred"), cls: "bold-warning" },
                { term: t("common:shared_terms.host"), cls: "" },
                { term: notif.metadata?.senderName, cls: "" },
                { term: notif.metadata?.groupName, cls: "" },
                { term: notif.metadata?.sessionName, cls: "" }
              ].filter(item => item.term && typeof item.term === "string" && !item.term.startsWith("notifications:styling_terms."));

              termsMap.sort((a, b) => b.term.length - a.term.length);

              termsMap.forEach(({ term, cls }) => {
                const escapedTerm = escapeHtml(term);
                const regexStr = escapedTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const regex = new RegExp(`(?<!>|<strong class="[^"]*">)(${regexStr})(?!<\\/strong>)`, 'g');
                const classAttr = cls ? ` class="${cls}"` : "";
                msg = msg.replace(regex, `<strong${classAttr}>$1</strong>`);
              });

              return msg;
            };
          %>
          <% notificationsData.cards.forEach(notif => { %>
            <%
              const type = notif.type || "general";
              let iconHtml = `<i class="bi bi-bell-fill"></i>`;
              if (notif.metadata && notif.metadata.senderPhotoURL && (type === "join_request" || type === "member_removed" || type === "join_invite" || notif.metadata.isInvite)) {
                iconHtml = `<img src="${escapeHtml(notif.metadata.senderPhotoURL)}" alt="avatar" />`;
              } else if (type === "join_request" || type === "join_invite" || (notif.metadata && notif.metadata.isInvite)) {
                iconHtml = `<i class="bi bi-person-fill"></i>`;
              } else if (type === "join_accepted" || type === "join_request_accepted" || type === "join_invite_accepted") {
                iconHtml = `<i class="bi bi-link-45deg"></i>`;
              } else if (type === "join_pending") {
                iconHtml = `<i class="bi bi-three-dots"></i>`;
              } else if (type === "join_rejected" || type === "join_request_rejected" || type === "join_invite_rejected") {
                iconHtml = `<i class="bi bi-x-lg"></i>`;
              } else if (type === "member_removed") {
                iconHtml = `<i class="bi bi-person-dash-fill"></i>`;
              } else if (type === "role_transferred") {
                iconHtml = `<i class="bi bi-arrow-left-right"></i>`;
              } else if (type === "role_demoted") {
                iconHtml = `<i class="bi bi-person-down"></i>`;
              } else if (type === "group_deleted") {
                iconHtml = `<i class="bi bi-people-fill"></i>`;
              } else if (type === "session_started") {
                iconHtml = `<i class="bi bi-clock-fill"></i>`;
              } else if (type === "session_ended") {
                iconHtml = `<i class="bi bi-check-lg"></i>`;
              }
              const timeStr = formatNotifDate(notif.timestamp);
              const categoryLabel = notif.category || "General";
            %>
            <div class="notif-card card-item <%= notif.read ? '' : 'unread' %>" data-id="<%= notif.id %>" data-type="<%= notif.type %>" data-category="<%= notif.category || 'All' %>" data-demande-id="<%= notif.metadata?.demandeId || '' %>" data-group-id="<%= notif.metadata?.groupId || '' %>" data-sender-name="<%= notif.metadata?.senderName || '' %>" data-group-name="<%= notif.metadata?.groupName || '' %>" data-session-id="<%= notif.metadata?.sessionId || '' %>" data-is-invite="<%= notif.metadata?.isInvite || '' %>">
              <div class="notif-icon <%= notif.type %>">
                <%- iconHtml %>
              </div>
              <div class="notif-content">
                <div class="notif-message"><%- formatNotifMsg(notif) %></div>
                <div class="notif-footer">
                  <span class="notif-meta"><%= timeStr %> • <%= categoryLabel %></span>
                  <%
                    const isAlreadyJoined = Boolean((notif.metadata && notif.metadata.joined) || (typeof user !== 'undefined' && user && user.currentSession && user.currentSession === (notif.metadata && notif.metadata.sessionId)));
                    const isCreator = Boolean((notif.metadata && notif.metadata.isAdmin) || (typeof user !== 'undefined' && user && notif.metadata && notif.metadata.creatorId && user.uid === notif.metadata.creatorId));
                  %>
                  <% if (notif.type === 'join_request' && !notif.metadata?.isInvite) { %>
                    <div class="notif-actions">
                      <button type="button" class="reject-btn exclude-btn small-btn" data-action="reject"><i class="bi bi-slash-circle"></i> <%= t("common:notifications_drawer.actions.reject") %></button>
                      <button type="button" class="accept-btn exclude-btn small-btn" data-action="accept"><i class="bi bi-check-circle"></i> <%= t("common:notifications_drawer.actions.accept") %></button>
                    </div>
                  <% } else if (notif.type === 'join_invite' || (notif.type === 'join_request' && notif.metadata?.isInvite)) { %>
                    <div class="notif-actions">
                      <button type="button" class="reject-invite-btn exclude-btn small-btn" data-action="reject"><i class="bi bi-slash-circle"></i> <%= t("common:notifications_drawer.actions.reject") %></button>
                      <button type="button" class="join-invite-btn exclude-btn small-btn" data-action="join"><i class="bi bi-box-arrow-in-right"></i> <%= t("common:notifications_drawer.actions.join") %></button>
                    </div>
                  <% } else if (notif.type === 'session_started' && !(notif.metadata && notif.metadata.sessionEnded) && !isAlreadyJoined && !isCreator) { %>
                    <div class="notif-actions">
                      <button type="button" class="join-session-btn exclude-btn small-btn"><i class="bi bi-box-arrow-in-right"></i> <%= t("common:notifications_drawer.actions.join") %></button>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="icon-wrapper">
            <div class="empty-icon-container">
              <i class="bi bi-bell-slash"></i>
            </div>
            <h3><%= t("common:notifications_drawer.empty_title") %></h3>
            <p><%= t("common:notifications_drawer.empty_sub") %></p>
          </div>
        <% } %>
      </div>
    </div>
    <!-- MOBILE TOPBAR HEADER (<= 48rem) -->
    <header class="mobile-topbar">
      <div class="mobile-topbar-left">
        <% const isSearchPage = ['/groups/my/', '/groups/available/', '/quizzes/my/', '/quizzes/passed/'].includes(resourcesRoute); %>
        <button type="button" class="exclude-btn mobile-icon-btn mobile-search-btn <%= isSearchPage ? '' : 'hidden' %>" title="<%= t('common:actions.search') %>">
          <i class="bi bi-search"></i>
        </button>
        <% const isSubpageReturn = resourcesRoute === '/groups/my/group-chat/' || resourcesRoute === '/quizzes/my/quiz-editor/'; %>
        <a href="<%= resourcesRoute === '/groups/my/group-chat/' ? '/app/groups/my' : '/app/quizzes/my' %>" class="mobile-back-btn route-link <%= isSubpageReturn ? '' : 'hidden' %>" title="<%= t('common:actions.return') %>">
          <i class="bi bi-arrow-left"></i>
        </a>
      </div>
      <div class="mobile-topbar-center">
        <h1 class="mobile-page-title">
          <% if (resourcesRoute === '/groups/my/group-chat/') { %>
            <button
            type="button"
            class="exclude-btn show-info-btn"
            >
            <i class="bi bi-info-circle"></i>
            <%= t("common:titles.group_chat") %>
          </button>
          <% } else if (resourcesRoute === '/quizzes/my/quiz-editor/') { %>
            <%= t("common:titles.quiz_editor") %>
          <% } else if (resourcesRoute.includes("/home/")) { %>
            <%= t("common:titles.home") %>
          <% } else if (resourcesRoute.includes("/groups/")) { %>
            <%= t("common:titles.groups") %>
          <% } else if (resourcesRoute.includes("/quizzes/")) { %>
            <%= t("common:titles.quizzes") %>
          <% } else if (resourcesRoute.includes("/settings/")) { %>
            <%= t("common:titles.account_settings") %>
          <% } else { %>
              StudyHype
          <% } %>
        </h1>
      </div>
      <div class="mobile-topbar-right">
        <button type="button" class="exclude-btn mobile-master-menu-btn" title="<%= t('common:actions.menu') %>">
          <i class="bi bi-list"></i>
        </button>
      </div>
    </header>

    <!-- MOBILE SEARCH BOX (<= 48rem) -->
    <div id="mobile-search-box" class="mobile-search-box hidden"></div>

    <!-- MOBILE NAVIGATION TABS CONTAINER (<= 48rem) -->
    <% const showGroupsTabs = resourcesRoute === '/groups/my/' || resourcesRoute === '/groups/available/'; %>
    <% const showQuizzesTabs = resourcesRoute === '/quizzes/my/' || resourcesRoute === '/quizzes/passed/'; %>
    <% const showQuizEditTabs = resourcesRoute === '/quizzes/my/quiz-editor/'; %>
    <% const showHomeTabs = resourcesRoute.includes('/home'); %>
    <% const showMobileTabs = showGroupsTabs || showQuizzesTabs || showQuizEditTabs || showHomeTabs; %>
    <div id="mobile-tabs-container" class="mobile-tabs-container<%= showMobileTabs ? '' : ' hidden' %>">
      <% if (showHomeTabs) { %>
      <div class="mobile-<%= hasActiveSession ? '' : 'in' %>active-tabs navigation-tabs" style="width: 100%;">
        <button type="button" class="tab active-tab exclude-btn" data-target="<%= hasActiveSession ? 'timer-session' : 'active-sessions' %>"><%= hasActiveSession ? t('common:mobile_nav.timer_session') : t('common:mobile_nav.active_sessions') %></button>
        <button type="button" class="tab exclude-btn" data-target="<%= hasActiveSession ? 'tasks' : 'recent-messages' %>"><%= hasActiveSession ? t('common:mobile_nav.tasks') : t('common:mobile_nav.recent_messages') %></button>
      <% if (hasActiveSession) { %>
        <button type="button" class="tab exclude-btn" data-target="chat"><%= t('common:mobile_nav.chat') %></button>
      <% } %>
      </div>
      <% } else if (showGroupsTabs) { %>
      <div class="mobile-groups-tabs navigation-tabs groups-tabs" style="width: 100%;">
        <a href="/app/groups/my" class="tab route-link<%= resourcesRoute === '/groups/my/' ? ' active-tab' : '' %> exclude-btn"><%= t("common:topbar.tabs.my_groups") %></a>
        <a href="/app/groups/available" class="tab route-link<%= resourcesRoute === '/groups/available/' ? ' active-tab' : '' %> exclude-btn"><%= t("common:titles.available_groups") %></a>
      </div>
      <% } else if (showQuizzesTabs || showQuizEditTabs) { %>
      <div class="mobile-<%= showQuizzesTabs ? 'quizzes' : 'quiz-editor' %>-tabs navigation-tabs quizzes-tabs" style="width: 100%;">
        <% if (showQuizzesTabs) { %>
        <a href="/app/quizzes/my" class="tab route-link<%= resourcesRoute === '/quizzes/my/' ? ' active-tab' : '' %> exclude-btn"><%= t("common:topbar.tabs.my_quizzes") %></a>
        <a href="/app/quizzes/passed" class="tab route-link<%= resourcesRoute === '/quizzes/passed/' ? ' active-tab' : '' %> exclude-btn"><%= t("common:topbar.tabs.passed_quizzes") %></a>
        <% } else { %>
        <button type="button" class="tab active-tab exclude-btn" data-target="quiz-editor"><%= t("common:titles.quiz_editor") %></button>
        <button type="button" class="tab exclude-btn" data-target="questions-list"><%= t("common:mobile_nav.questions_list") %></button>
        <% } %>
      </div>
      <% } %>
    </div>

    <!-- MOBILE MASTER MENU DRAWER -->
    <div class="mobile-drawer-backdrop"></div>
    <div class="mobile-master-drawer">
      <header class="mobile-drawer-header">
        <button type="button" id="mobile-theme-toggle-btn" class="exclude-btn toggle-container nav-btn should-fill" title="<%= t('common:sidebar.theme_tooltip') %>">
          <i class="bi bi-moon theme-toggle-icon"></i>
        </button>
        <button type="button" class="exclude-btn lang-toggle-btn nav-btn should-fill" title="<%= t('common:sidebar.switch_language_tooltip') %>" style="font-weight: 700;">
          <span class="lang-toggle-text"><%= lang === 'ar' ? 'EN' : 'AR' %></span>
        </button>
        <button type="button" class="exclude-btn mobile-drawer-close-btn" title="<%= t('common:actions.close') %>">
          <i class="bi bi-x-lg"></i>
        </button>
      </header>
      <div class="mobile-drawer-body">
        <div class="mobile-drawer-section">
          <span class="mobile-drawer-section-title"><%= t("common:mobile_nav.app_controls") %></span>
          <button type="button" class="exclude-btn mobile-drawer-btn mobile-notif-btn open-drop-down-btn">
            <i class="bi bi-bell"></i>
            <span><%= t("common:notifications_drawer.title") %></span>
            <% const mUnreadCount = (typeof notificationsData !== 'undefined' && notificationsData.unreadCount) ? notificationsData.unreadCount : 0; %>
            <span class="badge notification-badge <%= mUnreadCount > 0 ? '' : 'hidden' %>"><%= mUnreadCount > 99 ? '99+' : mUnreadCount %></span>
          </button>
        </div>
        <div class="mobile-drawer-section mobile-group-chat-actions hidden">
          <span class="mobile-drawer-section-title"><%= t("common:mobile_nav.group_actions") %></span>
          <div id="mobile-drawer-group-actions-list"></div>
        </div>
      </div>
      <footer class="mobile-drawer-footer">
        <div class="mobile-user-info">
          <div class="avatar">
            <% if (user.photoURL) { %>
              <img src="<%= user.photoURL %>" alt="avatar" />
            <% } else { %>
              <h4><%= user.fullName.charAt(0).toUpperCase() %></h4>
            <% } %>
          </div>
          <div class="profile-info">
            <span><%= user.fullName %></span>
            <span><%= user.email %></span>
          </div>
        </div>
        <button type="button" id="mobile-logout-button" class="red-btn mobile-logout-btn">
          <i class="bi bi-box-arrow-in-left"></i>
          <span><%= t("common:profile_menu.logout") %></span>
        </button>
      </footer>
    </div>

    <main><%- content %></main>

    <!-- MOBILE BOTTOM NAVBAR (Sticky Footer, <= 48rem) -->
    <nav class="mobile-bottomnav">
      <a href="/app/home" class="mobile-nav-item should-fill route-link<% if (resourcesRoute.includes("/home/")) { %> active<% } %>">
        <i class="bi bi-house<%_ if (resourcesRoute.includes("/home/")) { %>-fill<% } %>"></i>
        <span><%= t("common:titles.home") %></span>
      </a>
      <a href="/app/groups/my" class="mobile-nav-item should-fill route-link<% if (resourcesRoute.includes("/groups/")) { %> active<% } %>">
        <i class="bi bi-people<%_ if (resourcesRoute.includes("/groups/")) { %>-fill<% } %>"></i>
        <span><%= t("common:titles.groups") %></span>
      </a>
      <a href="/app/quizzes/my" class="mobile-nav-item should-fill route-link<% if (resourcesRoute.includes("/quizzes/")) { %> active<% } %>">
        <i class="bi bi-clipboard-check<% if (resourcesRoute.includes("/quizzes/")) { %>-fill<% } %>"></i>
        <span><%= t("common:titles.quizzes") %></span>
      </a>
      <a href="/app/settings" class="mobile-nav-item should-fill route-link<% if (resourcesRoute.includes("/settings/")) { %> active<% } %>">
        <i class="bi bi-person<%_ if (resourcesRoute.includes("/settings/")) { %>-fill<% } %>"></i>
        <span><%= t("common:titles.settings") %></span>
      </a>
    </nav>

    <div id="hover-tooltip" class="tooltip" role="tooltip"></div>
    <div id="global-tooltip" class="tooltip" role="tooltip"></div>
    <script
      type="module"
      src="/app/assets/global/js/main.js"
      crossorigin="anonymous"
    ></script>
    <script
      data-dynamic=""
      type="module"
      src="/app/assets<%- resourcesRoute %>js/main.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
