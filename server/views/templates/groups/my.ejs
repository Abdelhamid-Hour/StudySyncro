<div
  data-last-visible="<%= lastVisible || '' %>"
  class="main-content groups-list fade-in-template"
>
  <% if (cards && cards.length > 0) { %>
    <% cards.forEach(group => { %>
    <a
      href="/app/groups/my/<%= group.id %>/chat"
      class="group-card route-link card-item"
      data-id="<%= group.id %>"
    >
      <header>
        <span
          class="badge <%= group.visibility.charAt(0).toLowerCase() + group.visibility.slice(1) _%>-badge"
        >
          <%= group.visibility %>
        </span>
        <span class="badge <%= group.isHost ? 'orange-badge' : 'blue-badge' %>">
          <% if (group.isHost) { %>
          <i class="bi bi-person-fill-gear"></i>
          Host <% } else { %>
          <i class="bi bi-person-fill"></i>
          Member <% } %>
        </span>
      </header>
      <div class="group-meta">
        <h3 class="group-name"><%= group.name %></h3>
        <span class="subject-value badge simple-badge"><%= group.subject %></span>
      </div>
      <div
        data-tooltip="<%= group.description %>"
        class="group-description has-tooltip"
      >
        <%= group.description %>
      </div>
      <footer class="group-footer">
        <span
          class="level-value badge <%= group.level === 'Intermediate' ? 'blue-badge' : group.level === 'Advanced' ? 'orange-badge' : 'gray-badge' %>"
        >
          <%= group.level %>
        </span>
        <div class="avatars">
          <% group.avatars.forEach(({photoURL, fullName}) => { %>
          <div class="avatar">
            <% if (photoURL) { %>
            <img src="<%= photoURL %>" alt="avatar" />
            <% } else { %>
            <h4><%= fullName.charAt(0).toUpperCase() %></h4>
            <% } %>
          </div>
          <% }); %> <% if (group.extraMembersCount > 0) { %>
          <div class="member-count">+<%= group.extraMembersCount %></div>
          <% } %>
        </div>
      </footer>
    </a>
    <% }); %>
  <% } else { %>
    <div class="icon-wrapper">
      <div class="empty-icon-container">
        <i class="bi bi-people-fill"></i>
      </div>
      <h3>No Groups Joined</h3>
      <p>You are not a member of any study groups yet. Create or join a group to begin collaborating!</p>
    </div>
  <% } %>
</div>
<button type="button" class="mobile-create-group-btn create-group-btn exclude-btn" title="Create Group" aria-label="Create Group">
  <i class="bi bi-plus-lg"></i>
</button>
