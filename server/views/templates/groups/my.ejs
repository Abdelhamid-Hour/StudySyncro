<div data-last-visible="<%= lastVisible || '' %>" class="main-content groups-list fade-in-template">
  <% cards.forEach(group => { %>
  <a href="/app/groups/my/<%- group.id %>/chat" class="group-card route-link" data-id="<%= group.id %>">
    <header>
      <span
        class="badge <%= group.visibility === "Public" ? 'public-badge' : 'private-badge' %>"
      >
        <%= group.visibility === "Public" ? 'Public' : 'Private' %>
      </span>
      <span class="badge <%= group.creator === userId ? 'orange-badge' : 'blue-badge' %>">
        <% if (group.creator === userId) { %>
        <i class="bi bi-person-fill-gear"></i>
        Host <% } else { %>
        <i class="bi bi-person-fill"></i>
        Member <% } %>
      </span>
    </header>
    <div class="group-meta">
      <h3 class="group-title"><%= group.groupName %></h3>
      <span class="subject-value badge simple-badge"><%= group.subject %></span>
    </div>
    <div
      data-tooltip="<%= group.description %>"
      class="group-description has-tooltip"
    >
      <%= group.description %>
    </div>
    <footer class="group-footer">
      <span
        class="level-value badge <%= group.level === 'Intermediate' ? 'blue-badge' : group.level === 'Advanced' ? 'orange-badge' : 'gray-badge' %>"
      >
        <%= group.level %>
      </span>
      <div class="avatars">
        <% group.avatars.forEach(({photoURL, fullName}) => { %>
        <div class="avatar">
          <% if (photoURL) { %>
            <img
              src="<%= photoURL %>"
              alt="avatar"
            />
          <% } else { %>
            <h4><%= fullName.charAt(0).toUpperCase() %></h4>
          <% } %>
        </div>
        <% }); %> <% if (group.extraMembersCount > 0) { %>
        <div class="member-count">+<%= group.extraMembersCount %></div>
        <% } %>
      </div>
    </footer>
  </a>
  <% }); %>
</div>
