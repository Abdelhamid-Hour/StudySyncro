<div
  data-last-visible="<%= lastVisible || '' %>"
  class="main-content groups-list fade-in-template"
>
  <% if (cards && cards.length > 0) { %>
    <% cards.forEach(group => { %>
    <div class="group-card route-link card-item" data-id="<%= group.id %>">
      <header>
        <span
          class="badge <%= group.visibility.charAt(0).toLowerCase() + group.visibility.slice(1) _%>-badge"
        >
          <%= t('groups:badges.' + group.visibility.toLowerCase()) || group.visibility %>
        </span>
        <span
          class="level-value badge <%= group.level === 'Intermediate' ? 'blue-badge' : group.level === 'Advanced' ? 'orange-badge' : 'gray-badge' %>"
        >
          <%= t('groups:badges.' + group.level.toLowerCase()) || group.level %>
        </span>
      </header>
      <div class="group-meta">
        <h3 class="group-name"><bdi><%= group.name %></bdi></h3>
        <span class="subject-value badge simple-badge"><bdi><%= t("common:subjects." + group.subject, { defaultValue: group.subject }) %></bdi></span>
      </div>
      <div
        data-tooltip="<%= group.description %>"
        class="group-description has-tooltip"
      >
        <bdi><%= group.description %></bdi>
      </div>
      <footer class="group-footer">
        <div class="avatars">
          <% group.avatars.forEach(({photoURL, fullName}) => { %>
          <div class="avatar">
            <% if (photoURL) { %>
            <img src="<%= photoURL %>" alt="avatar" />
            <% } else { %>
            <h4><bdi><%= fullName.charAt(0).toUpperCase() %></bdi></h4>
            <% } %>
          </div>
          <% }); %> <% if (group.extraMembersCount > 0) { %>
          <div class="member-count">+<bdi><%= group.extraMembersCount %></bdi></div>
          <% } %>
        </div>
        
        <% if (group.isRequested) { %>
        <span class="pending-text"><i class="bi bi-hourglass-split"></i><%= t("groups:badges.pending") %></span>
        <% } else { %>
        <button class="btn-join">
          <% if ( group.visibility === "Public") { %>
          <i class="bi bi-send"></i>
          <%= t("groups:available.join_now") %> <% } else { %>
          <i class="bi bi-lock"></i>
          <%= t("groups:available.request_to_join") %> <% } %>
        </button>
        <% } %>
      </footer>
    </div>
    <% }); %>
  <% } else { %>
    <div class="icon-wrapper">
      <div class="empty-icon-container">
        <i class="bi bi-people-fill"></i>
      </div>
      <h3><%= t("groups:available.empty_heading") %></h3>
      <p><%= t("groups:available.empty_desc") %></p>
    </div>
  <% } %>
</div>
