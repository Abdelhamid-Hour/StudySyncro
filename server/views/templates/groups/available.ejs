<div data-next-last-id="<%= nextLastId %>" class="main-content groups-list fade-in-template">
  <% cards.forEach(group => { %>
  <div class="group-card route-link" data-id="<%= group.id %>">
    <header>
      <span
        class="badge <%= group.isPublic ? 'public-badge' : 'private-badge' %>"
      ><%= group.isPublic ? 'Public' : 'Private' %></span>
      <span
        class="level-value badge <%= group.level === 'Intermediate' ? 'blue-badge' : group.level === 'Advanced' ? 'orange-badge' : 'gray-badge' %>"
      >
        <%= group.level %>
      </span>
    </header>
    <div class="group-meta">
      <h3 class="group-title"><%= group.title %></h3>
      <span class="subject-value badge simple-badge"><%= group.subject %></span>
    </div>
    <div
      data-tooltip="<%= group.description %>"
      class="group-description has-tooltip"
    >
      <%= group.description %>
    </div>
    <footer class="group-footer">
      <div class="avatars">
        <% group.avatars.forEach(avatar => { %>
        <div class="avatar"><img src="<%= avatar %>" /></div>
        <% }); %> <% if (group.extraMembersCount > 0) { %>
        <div class="member-count">+<%= group.extraMembersCount %></div>
        <% } %>
      </div>
      <button class="btn-join">
        <% if (group.isPublic) { %>
          <i class="bi bi-send"></i> Join Now
        <% } else { %>
          <i class="bi bi-lock"></i> Request to Join
        <% } %>
      </button>
    </footer>
  </div>
  <% }); %>
</div>
