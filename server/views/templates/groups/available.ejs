<div
  data-last-visible="<%= lastVisible || '' %>"
  class="main-content groups-list fade-in-template"
>
  <% cards.forEach(group => { %>
  <div class="group-card route-link card-item" data-id="<%= group.id %>">
    <header>
      <span
        class="badge <%= group.visibility.charAt(0).toLowerCase() + group.visibility.slice(1) _%>-badge"
      >
        <%= group.visibility %>
      </span>
      <span
        class="level-value badge <%= group.level === 'Intermediate' ? 'blue-badge' : group.level === 'Advanced' ? 'orange-badge' : 'gray-badge' %>"
      >
        <%= group.level %>
      </span>
    </header>
    <div class="group-meta">
      <h3 class="group-name"><%= group.name %></h3>
      <span class="subject-value badge simple-badge"><%= group.subject %></span>
    </div>
    <div
      data-tooltip="<%= group.description %>"
      class="group-description has-tooltip"
    >
      <%= group.description %>
    </div>
    <footer class="group-footer">
      <div class="avatars">
        <% group.avatars.forEach(({photoURL, fullName}) => { %>
        <div class="avatar">
          <% if (photoURL) { %>
          <img src="<%= photoURL %>" alt="avatar" />
          <% } else { %>
          <h4><%= fullName.charAt(0).toUpperCase() %></h4>
          <% } %>
        </div>
        <% }); %> <% if (group.extraMembersCount > 0) { %>
        <div class="member-count">+<%= group.extraMembersCount %></div>
        <% } %>
      </div>
      
      <% if (group.isRequested) { %>
      <span class="pending-text"><i class="bi bi-hourglass-split"></i>Pending</span>
      <% } else { %>
      <button class="btn-join">
        <% if ( group.visibility === "Public") { %>
        <i class="bi bi-send"></i>
        Join Now <% } else { %>
        <i class="bi bi-lock"></i>
        Request to Join <% } %>
      </button>
      <% } %>
    </footer>
  </div>
  <% }); %>
</div>
