<div class="group-container fade-in-template">
  <aside class="group-left-side-bar close">
    <aside class="top-bar">
      <h2 class="side-bar-title">
        <span class="badge simple-badge"></span>
      </h2>
      <button type="button" class="exclude-btn close-group-left-btn">
            <i class="bi bi-x-lg"></i>
      </button>
    </aside>
    <div class="left-side-bar-content"></div>
  </aside>
  <div class="chat">
    <div class="top-bar">
      <!-- inffo bootstrap icon -->
      <button
        data-tooltip="<%= t('common:shared_terms.show_group_details') %>"
        type="button"
        class="exclude-btn show-info-btn has-tooltip"
      >
        <i class="bi bi-info-circle"></i>
      </button>
      <h2 class="title"><%= t("common:shared_terms.real_time_chat") %></h2>
      <% if (sessionId) { %>
        <% if (isAdmin) { %>
          <button type="button" data-session-id="<%= sessionId %>" class="small-btn red-btn end-session">
            <i class="bi bi-stop-circle"></i>
            <%= t("common:shared_terms.end_session") %>
          </button>
        <% } else if (!joined) { %>
          <button type="button" data-session-id="<%= sessionId %>" class="join-session small-btn blue-btn">
            <i class="bi bi-box-arrow-in-right"></i>
            <%= t("common:shared_terms.join_session") %>
          </button>
        <% } else if (joined) { %>
          <button type="button" data-session-id="<%= sessionId %>" class="leave-session small-btn red-btn">
            <i class="bi bi-box-arrow-left"></i>
            <%= t("common:shared_terms.leave_session") %>
          </button>
        <% } %>
      <span
        class="session-active-badge badge circle-badge-1 green-badge has-tooltip"
        data-tooltip="<%= t('common:shared_terms.active_session') %>"
      ></span>
      <% } else if(isAdmin) { %>
      <button type="button" class="small-btn create-session">
        <i class="bi bi-plus-circle"></i>
        <span><%= t("common:shared_terms.create_session") %></span>
      </button>
      <% } %>

      <div>
        <button
          type="button"
          class="exclude-btn group-chat-menu-btn open-drop-down-btn"
        >
          <i class="bi bi-three-dots-vertical"></i>
        </button>
        <div class="drop-down-menu group-chat-drop-down-menu overlay">
          <div class="drop-down-group">
            <div class="drop-down-group-label">
              <%= t("common:mobile_nav.group_actions") %>
              <hr class="separator" />
            </div>

            <button
              type="button"
              class="drop-down-item exclude-btn group-info-menu-btn"
            >
              <i class="bi bi-info-circle"></i>
              <%= t("common:shared_terms.group_info") %>
            </button>
            <button
              type="button"
              class="drop-down-item exclude-btn quizzes-list-menu-btn"
            >
              <i class="bi bi-clipboard-check"></i>
              <%= t("common:titles.quizzes") %>
            </button>
            <% if (sessionId) { %>
            <button
              type="button"
              class="drop-down-item exclude-btn session-info-menu-btn"
            >
              <i class="bi bi-clock-history"></i>
              <%= t("common:shared_terms.session_info") %>
            </button>
            <% } %> <% if (isAdmin) { %>
            <button type="button" class="drop-down-item exclude-btn add-members-menu-btn">
              <i class="bi bi-person-plus"></i>
              <%= t("common:shared_terms.invite_users") %>
            </button>
            <% if ( isRequested) { %>
            <button
              type="button"
              class="drop-down-item manage-demanes-menu-btn exclude-btn"
            >
              <i class="bi bi-list-check"></i>
              <%= t("common:shared_terms.manage_demandes") %>
            </button>
            <% } %> <% } %>
            <button
              type="button"
              class="drop-down-item exclude-btn members-list-menu-btn"
            >
              <i class="bi bi-people"></i>
              <%= isAdmin ? t("common:shared_terms.manage_members") : t("common:shared_terms.members") %>
            </button>
            <% if (isAdmin) { %>
            <button
              type="button"
              class="drop-down-item exclude-btn red-btn remove-group-menu-btn"
            >
              <i class="bi bi-trash3"></i>
              <%= t("common:shared_terms.remove_group") %>
            </button>
            <% } else { %>
            <button
              type="button"
              class="drop-down-item exclude-btn red-btn leave-group-menu-btn"
            >
              <i class="bi bi-box-arrow-left"></i>
              <%= t("common:shared_terms.leave_group") %>
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <div class="chat-messages"></div>
    <div class="input-message-container">
      <span class="newline-hint"><%= t("api:shift_enter_for_new_line") %></span>
      <div class="icons">
        <label for="image-upload" class="should-fill">
          <i class="bi bi-image"></i>
        </label>
        <label for="file-upload">
          <i class="bi bi-paperclip"></i>
        </label>
        <div class="emoji-picker">
          <button
            type="button"
            class="exclude-btn should-fill emoji-button open-drop-down-btn"
          >
            <i class="bi bi-emoji-smile"></i>
          </button>
          <div class="emoji-list overlay">
            <div class="categories">
              <a data-section-id="recent" class="recent should-fill">
                <i class="bi bi-clock"></i>
              </a>
              <a data-section-id="people" class="should-fill">
                <i class="bi bi-emoji-smile"></i>
              </a>
              <a data-section-id="animals_nature" class="should-fill">
                <i class="bi bi-tree"></i>
              </a>
              <a data-section-id="food_drink" class="should-fill">
                <i class="bi bi-cup"></i>
              </a>
              <a data-section-id="activity" class="should-fill">
                <i class="bi bi-calendar"></i>
              </a>
              <a data-section-id="objects" class="should-fill">
                <i class="bi bi-box"></i>
              </a>
              <a data-section-id="symbols" class="should-fill">
                <i class="bi bi-heart"></i>
              </a>
              <a data-section-id="travel_places" class="should-fill">
                <i class="bi bi-geo-alt"></i>
              </a>
              <a data-section-id="flags" class="should-fill">
                <i class="bi bi-flag"></i>
              </a>
            </div>
            <div class="emoji-search-container">
              <div class="search-icon-container">
                <i class="bi bi-search"></i>
              </div>
              <input
                type="search"
                placeholder="<%= t('common:shared_terms.search_for_emoji') %>"
                id="emojis-search-input"
                class="emojis-search-input"
              />
            </div>
            <div class="emojies-sections">
              <section id="recent">
                <h5><%= t("common:time.recent") %></h5>
                <div class="recent-emojies"></div>
              </section>
              <section id="people">
                <h5><%= t("common:shared_terms.people") %></h5>
                <div class="people-emojies"></div>
              </section>
              <section id="animals_nature">
                <h5><%= t("common:shared_terms.animals_nature") %></h5>
                <div class="animals-nature-emojies"></div>
              </section>
              <section id="food_drink">
                <h5><%= t("common:shared_terms.food_drink") %></h5>
                <div class="food-drink-emojies"></div>
              </section>
              <section id="activity">
                <h5><%= t("common:shared_terms.activity") %></h5>
                <div class="activity-emojies"></div>
              </section>
              <section id="objects">
                <h5><%= t("common:shared_terms.objects") %></h5>
                <div class="objects-emojies"></div>
              </section>
              <section id="symbols">
                <h5><%= t("common:shared_terms.symbols") %></h5>
                <div class="symbols-emojies"></div>
              </section>
              <section id="travel_places">
                <h5><%= t("common:shared_terms.travel_places") %></h5>
                <div class="travel-places-emojies"></div>
              </section>
              <section id="flags">
                <h5><%= t("common:shared_terms.flags") %></h5>
                <div class="flags-emojies"></div>
              </section>
            </div>
            <div id="search-result"></div>
          </div>
        </div>
        <input
          type="file"
          id="image-upload"
          class="file-input"
          accept="
          image/png,
          image/jpeg,
          image/jpg,
          image/gif,
          video/mp4,
          "
          multiple=""
        />
        <input
          multiple=""
          type="file"
          class="file-input"
          id="file-upload"
          accept=".pdf,
            .mp3,
            .doc,
            .docx,
            .xls,
            .xlsx,
            .ppt,
            .pptx,
            .txt,
            .rar"
        />
      </div>
      <textarea
        placeholder="<%= t('common:shared_terms.type_a_message') %>"
        class="input-message"
        id="input-message"
      ></textarea>
      <button type="button" class="send-btn exclude-btn should-fill">
        <i class="bi bi-send"></i>
      </button>
    </div>
  </div>
</div>

