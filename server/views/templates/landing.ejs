            </div>

            <div class="bento-card">
              <div class="bento-header">
                <div class="spotlight-badge">
                  <i class="bi bi-pencil-square"></i>
                  <span
                    ><%= t('root:features.bento_2.badge') %></span
                  >
                </div>
                <h3>
                  <%= t('root:features.bento_2.title') %>
                </h3>
                <p>
                  <%= t('root:features.bento_2.desc') %>
                </p>
              </div>
              <div class="bento-visual">
                <div class="feature-img-frame">
                  <img
                    loading="lazy"
                    src="<%= typeof theme !== 'undefined' && theme === 'dark' ? '/images/quiz/quiz-edit.webp' : '/images/quiz/quiz-edit-light.webp' %>"
                    data-dark-src="/images/quiz/quiz-edit.webp"
                    data-light-src="/images/quiz/quiz-edit-light.webp"
                    style="width: 100%; aspect-ratio: 16/9; height: auto;"
                    alt="<%= t('root:images.quiz_editor') %>"
                  />
