              <div class="spotlight-badge">
                <i class="bi bi-people-fill"></i>
                <span
                  ><%= t('root:features.spotlight_1.badge') %></span
                >
              </div>
              <h3>
                <%= t('root:features.spotlight_1.title') %>
              </h3>
              <p>
                <%= t('root:features.spotlight_1.desc') %>
              </p>
              <ul class="spotlight-highlights">
                <li>
                  <i class="bi bi-check-circle-fill"></i>
                  <span
                    ><%= t('root:features.spotlight_1.highlight_1') %></span
                  >
                </li>
                <li>
                  <i class="bi bi-check-circle-fill"></i>
                  <span
                    ><%= t('root:features.spotlight_1.highlight_2') %></span
                  >
                </li>
                <li>
                  <i class="bi bi-check-circle-fill"></i>
                  <span
                    ><%= t('root:features.spotlight_1.highlight_3') %></span
