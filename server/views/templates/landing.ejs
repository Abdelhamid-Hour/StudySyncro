<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title><%= t("api:studysyncro_elevate_your_learning_with_rea") %></title>
    <meta
      name="description"
      content="<%= t('root:landing_seo.description', { defaultValue: 'StudySyncro is a collaborative learning platform featuring real-time group study sessions, interactive chat, custom quiz editors, and productivity timers.' }) %>"
    />
    <meta
      name="keywords"
      content="<%= t('root:landing_seo.keywords', { defaultValue: 'StudySyncro, study groups, online learning, collaborative studying, real-time chat, quizzes, exam editor, study timer' }) %>"
    />
    <meta name="author" content="StudySyncro Team" />
    <meta name="robots" content="index, follow" />
    <meta name="application-name" content="StudySyncro" />
    <meta name="theme-color" content="#1e77fd" />
    <meta name="google-site-verification" content="hZ3lBJUXzO7xxlWuhW13pPmGwNAd4d7Bzr_IgrsRli4" />
    <link rel="canonical" href="<%= fullUrl %>" />

    <!-- Internationalization (i18n) SEO -->
    <link rel="alternate" hreflang="en" href="<%= baseUrl %><%= fullUrl.split('?')[0].replace(baseUrl, '') %>?lang=en" />
    <link rel="alternate" hreflang="ar" href="<%= baseUrl %><%= fullUrl.split('?')[0].replace(baseUrl, '') %>?lang=ar" />
    <link rel="alternate" hreflang="x-default" href="<%= baseUrl %><%= fullUrl.split('?')[0].replace(baseUrl, '') %>" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:site_name" content="StudySyncro" />
    <meta property="og:locale" content="<%= lang === 'ar' ? 'ar_AR' : 'en_US' %>" />
    <meta
      property="og:title"
      content="<%= t('root:landing_seo.og_title', { defaultValue: 'StudySyncro — Collaborative Study Spaces' }) %>"
    />
    <meta
      property="og:description"
      content="<%= t('root:landing_seo.description', { defaultValue: 'Join study groups, take interactive quizzes, and collaborate in real-time with peers around the world.' }) %>"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= fullUrl %>" />
    <meta
      property="og:image"
      content="<%= baseUrl %>/images/home/active-home-page.webp"
    />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= t('root:landing_seo.og_title', { defaultValue: 'StudySyncro — Collaborative Study Spaces' }) %>" />
    <meta name="twitter:description" content="<%= t('root:landing_seo.description', { defaultValue: 'Join study groups, take interactive quizzes, and collaborate in real-time with peers around the world.' }) %>" />
    <meta name="twitter:image" content="<%= baseUrl %>/images/home/active-home-page.webp" />

    <!-- JSON-LD Structured Data (Software) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "StudySyncro",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Any",
      "url": "<%= baseUrl %>",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
    </script>
    
    <!-- JSON-LD Structured Data (Organization) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "StudySyncro",
      "url": "<%= baseUrl %>",
      "logo": "<%= baseUrl %>/images/logo-mark.svg"
    }
    </script>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Favicon and Icons -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <!-- Fonts & Bootstrap Icons -->
    <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" as="style" id="font-arabic-preload" />
    <% } %>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" as="style" id="font-inter-preload" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" as="style" id="font-icons-preload" />
    <script nonce="<%= nonce %>">
      document.getElementById('font-inter-preload').rel = 'stylesheet';
      document.getElementById('font-icons-preload').rel = 'stylesheet';
      var arabicFont = document.getElementById('font-arabic-preload');
      if (arabicFont) arabicFont.rel = 'stylesheet';
    </script>
    <noscript>
      <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" id="font-arabic" />
      <% } %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" id="font-inter" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" id="font-icons" />
    </noscript>

    <!-- Global Website Styles & Native Tokens -->
    <link rel="stylesheet" href="/main_assets/css/variables_and_fonts.css" />
    <link rel="stylesheet" href="/main_assets/css/styles.css" />
    <link rel="stylesheet" href="/main_assets/css/landing.css" />
  </head>
  <body>
    <!-- Navigation Bar -->
    <nav class="landing-nav">
      <a href="/" class="landing-brand" style="text-decoration: none">
        <img
          src="/images/logo-mark.svg"
          alt="<%= t('root:images.logo_alt') %>"
          style="width: 1.8rem; height: 1.8rem"
        />
        <span
          >StudySyncro</span
        >
      </a>

      <ul class="landing-nav-links">
        <li><a href="#features"><%= t('common:shared_terms.features') %></a></li>
        <li>
          <a href="#workflow"><%= t('common:shared_terms.how_it_works') %></a>
        </li>
        <li><a href="#stats"><%= t('root:nav.community') %></a></li>
      </ul>

      <div class="landing-nav-actions">
        <button
          class="button exclude-btn toggle-theme-btn"
          id="theme-toggle-btn"
          title="<%= t('common:shared_terms.toggle_dark_light_mode') %>"
          aria-label="Toggle Dark or Light Mode"
        >
          <i class="bi <%= typeof theme !== 'undefined' && theme === 'dark' ? 'bi-sun' : 'bi-moon' %> theme-toggle-icon" id="theme-toggle-icon"></i>
        </button>
        <button
          class="button exclude-btn lang-toggle-btn"
          title="<%= lang === 'ar' ? t('shared:actions.switch_to_en') : t('shared:actions.switch_to_ar') %>"
          aria-label="Switch Language"
          data-target="<%= lang === 'ar' ? 'en' : 'ar' %>"
        >
          <i class="bi bi-globe"></i>
          <span class="lang-toggle-text"><%= lang === 'ar' ? 'EN' : 'AR' %></span>
        </button>
        <a href="/login" class="button blue-btn login-btn">
          <span><%= t('common:shared_terms.login') %></span>
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </nav>

    <main class="landing-wrapper fade-in-template">
      <!-- Hero Section -->
      <header class="landing-hero">
        <h1>
          <%= t('root:hero.title') %>
        </h1>
        <p>
          <%= t('root:hero.subtitle') %>
        </p>

        <div class="hero-actions">
          <a href="/login" class="button blue-btn">
            <span><%= t('root:hero.get_started_btn') %></span>
            <i class="bi bi-box-arrow-in-right"></i>
          </a>
          <a href="#features" class="button">
            <span
              ><%= t('root:hero.explore_features_btn') %></span
            >
            <i class="bi bi-chevron-down"></i>
          </a>
        </div>

        <!-- Hero Showcase Mockup -->
        <div class="hero-showcase-box">
          <img
            id="hero-img-lcp"
            fetchpriority="high"
            src="<%= typeof theme !== 'undefined' && theme === 'dark' ? '/images/home/active-home-page.webp' : '/images/home/active-home-page-light.webp' %>"
            data-dark-src="/images/home/active-home-page.webp"
            data-light-src="/images/home/active-home-page-light.webp"
            style="width: 100%; aspect-ratio: 16/9; height: auto;"
            alt="<%= t('root:images.dashboard_preview') %>"
          />
        </div>
      </header>

      <!-- Live Community Stats -->
      <section class="landing-stats" id="stats">
        <div class="stat-box">
          <h3>15,000+</h3>
          <p>
            <%= t('root:stats.active_students') %>
          </p>
        </div>
        <div class="stat-box">
          <h3>50,000+</h3>
          <p>
            <%= t('root:stats.quizzes_completed') %>
          </p>
        </div>
        <div class="stat-box">
          <h3>3,500+</h3>
          <p><%= t('root:stats.study_groups') %></p>
        </div>
        <div class="stat-box">
          <h3>98%</h3>
          <p>
            <%= t('root:stats.productivity_boost') %>
          </p>
        </div>
      </section>

      <!-- Features Grid Section -->
