        >
      </a>

      <ul class="landing-nav-links">
        <li><a href="#features" data-i18n="root:nav.features"><%= t('common:shared_terms.features') %></a></li>
        <li>
          <a href="#workflow" data-i18n="root:nav.how_it_works"><%= t('common:shared_terms.how_it_works') %></a>
        </li>
        <li><a href="#stats" data-i18n="root:nav.community"><%= t('root:nav.community') %></a></li>
      </ul>

      <div class="landing-nav-actions">
        <button
          class="button exclude-btn toggle-theme-btn"
          id="theme-toggle-btn"
          data-i18n-title="root:nav.toggle_theme"
          title="<%= t('common:shared_terms.toggle_dark_light_mode') %>"
          aria-label="Toggle Dark or Light Mode"
        >
          <i class="bi bi-moon theme-toggle-icon" id="theme-toggle-icon"></i>
        </button>
        <button
          class="button exclude-btn lang-toggle-btn"
          title="<%= lang === 'ar' ? t('shared:actions.switch_to_en') : t('shared:actions.switch_to_ar') %>"
          aria-label="Switch Language"
          data-target="<%= lang === 'ar' ? 'en' : 'ar' %>"
        >
