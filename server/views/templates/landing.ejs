                  data-light-src="/images/groups/available-groups-light.webp"
                  style="width: 100%; aspect-ratio: 16/9; height: auto;"
                  alt="<%= t('root:images.study_groups') %>"
                />
              </div>
            </div>
          </div>

          <!-- Flagship Spotlight 2: Real-Time Chat & Sharing -->
