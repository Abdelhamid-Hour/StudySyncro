                  alt="<%= t('root:images.chat_interface') %>"
                />
              </div>
            </div>
            <div class="spotlight-content">
              <div class="spotlight-badge">
                <i class="bi bi-chat-dots-fill"></i>
                <span
                  ><%= t('root:features.spotlight_2.badge') %></span
                >
              </div>
              <h3>
                <%= t('root:features.spotlight_2.title') %>
              </h3>
              <p>
                <%= t('root:features.spotlight_2.desc') %>
              </p>
              <ul class="spotlight-highlights">
                <li>
                  <i class="bi bi-check-circle-fill"></i>
                  <span
                    ><%= t('root:features.spotlight_2.highlight_1') %></span
                  >
                </li>
                <li>
                  <i class="bi bi-check-circle-fill"></i>
                  <span
                    ><%= t('root:features.spotlight_2.highlight_2') %></span
                  >
                </li>
                <li>
                  <i class="bi bi-check-circle-fill"></i>
                  <span
                    ><%= t('root:features.spotlight_2.highlight_3') %></span
                  >
                </li>
              </ul>
            </div>
          </div>

          <!-- Interactive Quiz Engine Bento Row -->
          <div class="feature-bento-row">
            <div class="bento-card">
              <div class="bento-header">
                <div class="spotlight-badge">
                  <i class="bi bi-patch-question-fill"></i>
                  <span
                    ><%= t('root:features.bento_1.badge') %></span
                  >
                </div>
                <h3>
                  <%= t('root:features.bento_1.title') %>
                </h3>
                <p>
                  <%= t('root:features.bento_1.desc') %>
                </p>
              </div>
              <div class="bento-visual">
                <div class="feature-img-frame">
                  <img
                    loading="lazy"
                    src="<%= typeof theme !== 'undefined' && theme === 'dark' ? '/images/quiz/quiz-play.webp' : '/images/quiz/quiz-play-light.webp' %>"
                    data-dark-src="/images/quiz/quiz-play.webp"
                    data-light-src="/images/quiz/quiz-play-light.webp"
                    style="width: 100%; aspect-ratio: 16/9; height: auto;"
                    alt="<%= t('root:images.quizzes_preview') %>"
                  />
                </div>
