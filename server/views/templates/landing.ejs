            <div class="spotlight-visual">
              <div class="feature-img-frame">
                <img
                  loading="lazy"
                  src="<%= typeof theme !== 'undefined' && theme === 'dark' ? '/images/chat/group-chat.webp' : '/images/chat/group-chat-light.webp' %>"
                  data-dark-src="/images/chat/group-chat.webp"
                  data-light-src="/images/chat/group-chat-light.webp"
