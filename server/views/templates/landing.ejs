      <!-- Workflow / How It Works -->
      <section id="workflow">
        <div class="section-title-box">
          <h2><%= t('root:workflow.section_title') %></h2>
          <p>
            <%= t('root:workflow.section_desc') %>
          </p>
        </div>

        <div class="landing-workflow-grid">
          <div class="workflow-step-box">
            <div class="workflow-step-number">1</div>
            <h3>
              <%= t('root:workflow.step_1.title') %>
            </h3>
            <p>
              <%= t('root:workflow.step_1.desc') %>
            </p>
          </div>

          <div class="workflow-step-box">
            <div class="workflow-step-number">2</div>
            <h3>
              <%= t('root:workflow.step_2.title') %>
            </h3>
            <p>
              <%= t('root:workflow.step_2.desc') %>
            </p>
          </div>

          <div class="workflow-step-box">
            <div class="workflow-step-number">3</div>
            <h3><%= t('root:workflow.step_3.title') %></h3>
            <p>
              <%= t('root:workflow.step_3.desc') %>
            </p>
          </div>
        </div>
      </section>

      <!-- Call to Action Section -->
      <section class="landing-cta-box">
        <h2>
          <%= t('root:cta.title') %>
        </h2>
        <p>
          <%= t('root:cta.desc') %>
        </p>
        <a href="/login" class="button blue-btn">
          <span><%= t('root:cta.btn') %></span>
          <i class="bi bi-arrow-right-circle-fill"></i>
        </a>
      </section>

      <!-- Footer -->
      <footer class="landing-footer">
        <div
          class="landing-brand"
          style="
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
          "
        >
          <img
            src="/images/logo-mark.svg"
            alt="<%= t('root:images.logo_alt') %>"
            style="width: 1.8rem; height: 1.8rem"
          />
          <span style="font-weight: 800; letter-spacing: -0.3px"
            >StudySyncro</span
          >
        </div>

        <div class="landing-footer-links">
          <a href="#features"><%= t('common:shared_terms.features') %></a>
          <a href="#workflow"
            ><%= t('common:shared_terms.how_it_works') %></a
          >
          <a href="/login"><%= t('common:shared_terms.login') %></a>
        </div>

        <p>
          <%= t('root:footer.copyright') %>
        </p>
      </footer>
    </main>

    <!-- Native Theme Switcher Script -->
    <script nonce="<%= nonce %>">
      (function () {
        const toggleBtn = document.getElementById("theme-toggle-btn");
        const toggleIcon = document.getElementById("theme-toggle-icon");
        const root = document.documentElement;

        toggleBtn?.addEventListener("click", () => {
          const isDark = root.getAttribute("data-theme") === "dark";

          const rect = toggleBtn.getBoundingClientRect();
          const x = rect.left + rect.width / 2;
          const y = rect.top + rect.height / 2;
          root.style.setProperty("--theme-toggle-x", `${x}px`);
          root.style.setProperty("--theme-toggle-y", `${y}px`);

          const doSwitch = () => applyTheme(!isDark, true);

          if (document.startViewTransition) {
            document.startViewTransition(doSwitch);
          } else {
            doSwitch();
          }
        });

        function applyTheme(toDark, save) {
          const theme = toDark ? "dark" : "light";
          root.setAttribute("data-theme", theme);
          if (toggleIcon)
            toggleIcon.className = toDark
              ? "bi bi-sun theme-toggle-icon"
              : "bi bi-moon theme-toggle-icon";

          document
            .querySelectorAll("img[data-dark-src][data-light-src]")
            .forEach((img) => {
              const targetSrc = toDark
                ? img.getAttribute("data-dark-src")
                : img.getAttribute("data-light-src");
              if (img.getAttribute("src") !== targetSrc) {
                img.setAttribute("src", targetSrc);
              }
            });

          if (save) {
            try {
              localStorage.setItem("theme", theme);
              localStorage.setItem("mode", theme);
              localStorage.setItem("studysyncro_theme", theme);
              document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax`;
            } catch (e) {}
          }
        }
      })();
    </script>
    <script type="module" nonce="<%= nonce %>">
      import { initLanguageSwitcher } from "/main_assets/js/i18n.mjs";
      initLanguageSwitcher();
    </script>
  </body>
</html>

