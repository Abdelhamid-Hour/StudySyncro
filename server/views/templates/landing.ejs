          </div>

          <!-- Productivity & Management Bento Row -->
          <div class="feature-bento-row bento-asymmetric">
            <div class="bento-card bento-widget">
              <div class="bento-header">
                <div class="spotlight-badge">
                  <i class="bi bi-stopwatch-fill"></i>
                  <span
                    ><%= t('root:features.bento_3.badge') %></span
                  >
                </div>
                <h3>
                  <%= t('root:features.bento_3.title') %>
                </h3>
                <p>
                  <%= t('root:features.bento_3.desc') %>
