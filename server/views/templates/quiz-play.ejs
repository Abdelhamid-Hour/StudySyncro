<div class="quiz-view">
  <a class="button close-btn exclude-btn has-tooltip" data-tooltip="<%= t('common:actions.close') %>">
    <i class="bi bi-x-lg"></i>
  </a>
  <div class="questions-view">
    <header class="quiz-header">
      <% if (typeof duration !== 'undefined' && duration > 0) { %>
      <div class="timer">
        <span class="time-left">
          <span class="icon-box"><i class="bi bi-stopwatch-fill"></i></span>
          <%= t("quizzes:play.time_left") %>
        </span>
        <div class="timer-digits">
          <span class="hours key-hint">00</span>
          <span>:</span>
          <span class="minutes key-hint">50</span>
          <span>:</span>
          <span class="seconds key-hint">30</span>
        </div>
      </div>
      <% } %>
      <h3 class="quiz-title"><bdi><%= quizTitle %></bdi></h3>
    </header>
    <div class="question-view">
      <header class="question-view-header">
        <h4>
          <span class="icon-box">
            <i class="bi bi-patch-question"></i>
          </span>
          <span class="question-count counter">
            <%= t("quizzes:play.question_label") %>
            <span class="current-question-number">1</span>
            <%= t("quizzes:play.of_label") %> <bdi><%= totalQuestions %></bdi>
          </span>
        </h4>
        <button type="button" class="gray-btn skip-btn has-tooltip" data-tooltip="<%= t('quizzes:play.skip_tooltip') %>"><%= t("quizzes:play.skip") %></button>
      </header>
      <div class="question-body">
        <h4><bdi><%= firstQuestion.text %></bdi></h4>
        <div class="question-choices">
          <span class="select-answer-label"><%= t("quizzes:play.select_answer") %> <span style="opacity: 0.65; font-size: 0.85em; font-weight: normal;"><%= t("quizzes:play.select_hint") %></span></span>
          <div class="choices-list">
            <% firstQuestion.choices.forEach(function(choice, idx) { %>
              <label class="choice">
                <input type="radio" value="<%= idx %>" name="choice" />
                <span class="choice-label"><%= String.fromCharCode(65 + idx) %></span>
                <span class="choice-text"><bdi><%= choice %></bdi></span>
              </label>
            <% }); %>
          </div>
        </div>
      </div>
      <footer class="question-actions-row">
        <div class="prev action">
          <button class="prev-btn gray-btn"><%= t("quizzes:play.prev") %></button>
          <span><%= t("quizzes:play.or_press") %></span>
          <i class="left-key icon"></i>
        </div>
        <div class="next action">
          <span><%= t("quizzes:play.press") %></span>
          <i class="right-key icon"></i>
          <span><%= t("common:shared_terms.or") %></span>
          <i class="enter-key icon"></i>
          <button class="next-btn blue-btn"><%= t("quizzes:play.next") %></button>
        </div>
      </footer>
    </div>
  </div>
</div>
