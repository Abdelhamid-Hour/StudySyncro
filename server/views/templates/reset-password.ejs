<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script nonce="<%= nonce %>">
      (function () {
        try {
          var theme = localStorage.getItem("theme") || "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <title><%= t('common:shared_terms.reset_your_password') %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Prevent indexing for security -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- SEO & Page Information -->
    <meta name="title" content="<%= t('common:shared_terms.reset_your_password') %> - StudySyncro" />
    <meta
      name="description"
      content="<%= t('reset_password:metadata.meta_description') %>"
    />
    <meta name="author" content="StudyHive Team" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon.png"
    />
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      rel="modulepreload"
      href="/reset-password/assets/js/main.mjs"
      as="script"
      crossorigin="anonymous"
    />
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/main_assets/css/variables_and_fonts.css" />
    <link rel="stylesheet" href="/main_assets/css/styles.css" />
    <link rel="stylesheet" href="/reset-password/assets/css/styles.css" />
    <!-- font -->
    <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" as="style" id="font-arabic-preload" />
    <% } %>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" as="style" id="font-inter-preload" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" as="style" id="font-icons-preload" />
    <script nonce="<%= nonce %>">
      document.getElementById('font-inter-preload').rel = 'stylesheet';
      document.getElementById('font-icons-preload').rel = 'stylesheet';
      const arabicFont = document.getElementById('font-arabic-preload');
      if (arabicFont) arabicFont.rel = 'stylesheet';
    </script>
    <noscript>
      <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" id="font-arabic" />
      <% } %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" id="font-inter" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    </noscript>
  </head>
  <body>
    <a
      href="/"
      class="login-top-logo button exclude-btn"
      style="
        position: absolute;
        top: 1.5rem;
        inset-inline-start: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        z-index: 999;
        text-decoration: none;
        padding: 0.45rem 1rem;
        border-radius: 5px;
        border: 1px solid var(--btn-border-color);
        background-color: var(--btn-background-color);
        color: var(--heading-color);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
      "
    >
      <img
        src="/images/logo-mark.svg"
        alt="<%= t('common:images.logo_alt', { defaultValue: 'StudySyncro Logo' }) %>"
        style="width: 1.8rem; height: 1.8rem"
      />
      <span
        style="
          font-size: 1.25rem;
          font-weight: 800;
          color: var(--heading-color);
          letter-spacing: -0.5px;
        "
        >StudySyncro</span
      >
    </a>
    <div
      class="top-nav-bar"
      style="
        position: absolute;
        top: 1.5rem;
        inset-inline-end: 1.5rem;
        display: flex;
        gap: 0.8rem;
        z-index: 999;
      "
    >
      <a
        href="/"
        class="button exclude-btn"
        title="<%= t('common:titles.home') %>"
        aria-label="Back to Home"
        style="
          padding: 0.5rem 1rem;
          border-radius: 5px;
          border: 1px solid var(--btn-border-color);
          background-color: var(--btn-background-color);
          color: var(--btn-text-color);
          display: flex;
          align-items: center;
          gap: 0.5rem;
          text-decoration: none;
        "
      >
        <i class="bi bi-house-door-fill"></i>
        <span><%= t('common:titles.home') %></span>
      </a>
      <button
        class="button exclude-btn toggle-theme-btn"
        id="theme-toggle-btn"
        title="<%= t('common:shared_terms.toggle_dark_light_mode') %>"
        aria-label="Toggle Dark or Light Mode"
        style="
          padding: 0.5rem 0.8rem;
          border-radius: 5px;
          border: 1px solid var(--btn-border-color);
          background-color: var(--btn-background-color);
          color: var(--btn-text-color);
          font-size: 1.1rem;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
        "
      >
        <i class="bi bi-moon theme-toggle-icon" id="theme-toggle-icon"></i>
      </button>
      <button
        class="button exclude-btn lang-toggle-btn"
        title="<%= lang === 'ar' ? t('shared:actions.switch_to_en') : t('shared:actions.switch_to_ar') %>"
        aria-label="Switch Language"
        data-target="<%= lang === 'ar' ? 'en' : 'ar' %>"
        style="
          padding: 0.5rem 0.8rem;
          border-radius: 5px;
          border: 1px solid var(--btn-border-color);
          background-color: var(--btn-background-color);
          color: var(--btn-text-color);
          font-size: 0.95rem;
          font-weight: 700;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          gap: 0.3rem;
        "
      >
        <i class="bi bi-globe"></i>
        <span class="lang-toggle-text"><%= lang === 'ar' ? 'EN' : 'AR' %></span>
      </button>
    </div>
    <main>
      <h2><%= t('common:shared_terms.reset_your_password') %></h2>
      <form>
        <div class="password-container">
          <div class="md-password-container">
            <div>
              <i class="bi bi-lock-fill"></i>
            </div>
            <div class="password-container-label">
              <label for="password">
                <div></div>
                <span
                  ><%= t('common:shared_terms.new_password') %></span
                >
              </label>
              <input
                placeholder=""
                type="password"
                class="password"
                id="password"
                required
                autocomplete="off"
              />
              <div class="eye-icon">
                <i class="bi bi-eye-fill"></i>
                <div>
                  <hr />
                </div>
              </div>
            </div>
          </div>
          <div class="error-container">
            <span class="error-msg"></span>
          </div>
        </div>
        <div class="password-container">
          <div class="md-password-container">
            <div>
              <i class="bi bi-lock-fill"></i>
            </div>
            <div class="password-container-label">
              <label for="confirm-password">
                <div></div>
                <span
                  ><%= t('common:shared_terms.confirm_password') %></span
                >
              </label>
              <input
                placeholder=""
                type="password"
                class="password"
                id="confirm-password"
                required
                autocomplete="off"
              />
              <div class="eye-icon">
                <i class="bi bi-eye-fill"></i>
                <div>
                  <hr />
                </div>
              </div>
            </div>
          </div>
          <div class="error-container">
            <span class="error-msg"></span>
          </div>
        </div>
        <button
          id="reset-password-btn"
          type="button"

        >
          <%= t('reset_password:main.reset_btn') %>
        </button>
      </form>
    </main>
    <script
      type="module"
      nonce="<%= nonce %>"
      src="/reset-password/assets/js/main.mjs"
      crossorigin="anonymous"
    ></script>
  </body>
</html>

