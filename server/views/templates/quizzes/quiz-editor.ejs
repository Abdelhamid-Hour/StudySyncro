<div class="quiz-editor fade-in-template">
  <section class="questions-panel">
    <header class="questions-header">
      <h4 class="panel-title">
        <%= t("quizzes:labels.questions") %>
        <span class="count badge simple-badge"><bdi><%= questions.length %></bdi></span>
      </h4>
      <button
        type="button"
        class="add-question-btn exclude-btn should-fill"
        data-tooltip="<%= t('quizzes:editor.add_question') %>"
      >
        <i class="bi bi-plus-circle"></i>
      </button>
    </header>
    <div class="questions-list">
      <% questions.forEach(function(q, idx) { %>
        <div class="question">
          <% if (idx === 0) { %>
           <div class="drop-target"></div>
          <% } %>
          <a
            draggable="false"
            href="#<%= q.id %>"
            class="question-card"
          >
            <header class="question-card-header">
              <h4>
                <span class="icon-box">
                  <i class="bi bi-patch-question"></i>
                </span>
                <span class="question-count counter"><%= t("quizzes:editor.question_num", { num: idx + 1 }) %></span>
              </h4>
              <button
                type="button"
                class="exclude-btn drag-handle has-tooltip"
                data-tooltip="<%= t('quizzes:editor.drag_to_reorder') %>"
              >
                <i class="drag-icon"></i>
              </button>
            </header>
            <p class="question-text"><bdi><%= q.text %></bdi></p>
            <footer class="question-card-footer">
              <span class="choices-count"><%= t("quizzes:plural_counts.choices", { count: q.choices.length }) %></span>
              <button
                type="button"
                class="delete-question-btn exclude-btn has-tooltip"
                data-tooltip="<%= t('quizzes:editor.delete_question') %>"
              >
                <i class="bi bi-trash3"></i>
              </button>
            </footer>
          </a>
          <div class="drop-target"></div>
        </div>
      <% }); %>
    </div>
  </section>
  <section class="question-editor-panel">
    <header class="editor-header">
      <div class="subject">
        <div class="container">
          <span class="subject-label label">
            <span class="icon-box">
              <i class="bi bi-book"></i>
            </span>
            <%= t("quizzes:editor.subject_label") %>
          </span>
          <span class="subject-value value"><bdi><%= subject %></bdi></span>
          <button
            class="exclude-btn edit-subject-btn has-tooltip"
            data-tooltip="<%= t('quizzes:editor.edit_subject') %>"
            type="button"
          >
            <i class="bi bi-pencil-square"></i>
          </button>
        </div>
      </div>
      <div class="title">
        <div class="container">
          <h4 class="title-text"><bdi><%= title %></bdi></h4>
          <button
            class="exclude-btn edit-title-btn has-tooltip"
            data-tooltip="<%= t('quizzes:editor.edit_title') %>"
            type="button"
          >
            <i class="bi bi-pencil-square"></i>
          </button>
        </div>
      </div>
      <span class="shared-in">
        <span class="shared-in-label label">
          <span class="icon-box">
            <i class="bi bi-people"></i>
          </span>
          <%= t("quizzes:editor.shared_in_label") %>
        </span>
        <span class="groups-count value">
          <span class="count badge simple-badge"><bdi><%= formatNumber(groupsCount) %></bdi></span>
          <%= t("quizzes:plural_counts.groups", { count: groupsCount }) %>
        </span>
        <span class="sessions-count value">
          <span class="count badge simple-badge"><bdi><%= formatNumber(sessionsCount) %></bdi></span>
          <%= t("quizzes:plural_counts.sessions", { count: sessionsCount }) %>
        </span>
      </span>
    </header>
    <div class="questions-list">
      <% questions.forEach(function(q, idx) { %>
        <div class="question-editor-box" id="<%= q.id %>">
          <header class="question-header">
            <h4>
              <span class="icon-box">
                <i class="bi bi-patch-question"></i>
              </span>
              <span class="question-count counter"><%= t("quizzes:editor.question_num", { num: idx + 1 }) %></span>
            </h4>
            <button
              type="button"
              class="delete-question-btn exclude-btn has-tooltip"
              data-tooltip="<%= t('quizzes:editor.delete_question') %>"
            >
              <i class="bi bi-trash3"></i>
            </button>
          </header>
          <textarea
            class="question-input input"
            placeholder="<%= t('quizzes:editor.question_placeholder') %>"
            id="question-text"
            style="height: 45px"
          ><%= q.text %></textarea>
          <div class="choices-section">
            <h5 class="choices-title section-title">
              <span class="icon-box">
                <i class="bi bi-list-ol"></i>
              </span>
              <%= t("quizzes:editor.choices") %>
            </h5>
            <div class="choices-list">
              <% q.choices.forEach(function(choice, cidx) { %>
                <div data-choice-id="<%= cidx %>" class="choice<%= q.correctAnswerIndex === cidx ? ' correct-answer' : '' %>">
                  <span class="choice-label"><%= String.fromCharCode(65 + cidx) %></span>
                  <input
                    type="text"
                    class="choice-input input"
                    placeholder="<%= t('quizzes:editor.choice_placeholder', { letter: String.fromCharCode(65 + cidx) }) %>"
                    value="<%= choice %>"
                  />
                  <button
                    type="button"
                    class="delete-choice-btn exclude-btn has-tooltip"
                    data-tooltip="<%= t('quizzes:editor.delete_choice') %>"
                  >
                    <i class="bi bi-trash3"></i>
                  </button>
                </div>
              <% }); %>
            </div>
            <button type="button" class="add-choice-btn small-btn">
              <i class="bi bi-plus-circle"></i>
              <%= t("quizzes:editor.add_choice") %>
            </button>
            <hr />
            <h5 class="correct-answer-title section-title">
              <span class="icon-box">
                <i class="bi bi-check-circle"></i>
              </span>
              <%= t("quizzes:editor.correct_answer") %>
            </h5>
            <div class="correct-answer-select">
              <div class="icon-box">
                <i class="bi bi-check-circle"></i>
              </div>
              <div class="select-trigger input">
                <button type="button" class="exclude-btn open-drop-down-btn">
                  <span class="correct-answer-value"><%= String.fromCharCode(65 + q.correctAnswerIndex) %></span>
                  <input type="hidden" name="correct-answer" value="<%= q.correctAnswerIndex %>" />
                  <i class="bi bi-chevron-down"></i>
                </button>
                <div
                  class="select-menu group-subject-select-menu drop-down-menu overlay"
                >
                  <% q.choices.forEach(function(choice, cidx) { %>
                    <label class="drop-down-item">
                      <input
                        type="radio"
                        name="correct-answer-<%= idx + 1 %>"
                        value="<%= cidx %>"
                        <%= q.correctAnswerIndex === cidx ? 'checked' : '' %>
                      />
                      <%= String.fromCharCode(65 + cidx) %>
                    </label>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
      <button type="button" class="exclude-btn add-question-btn">
        <i class="bi bi-plus-circle"></i>
        <hr />
      </button>
    </div>
  </section>
</div>
