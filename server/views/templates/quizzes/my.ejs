<div data-last-visible="<%= lastVisible || '' %>" class="quizzes-list fade-in-template">
  <% if (cards && cards.length > 0) { %>
  <% cards.forEach(function(quiz) { %>
    <div data-quiz-id="<%= quiz.id %>" class="quiz-card card-item">
      <header class="quiz-card-header">
        <% if (quiz.status==="draft" ) { %>
          <span class="badge gray-badge has-tooltip" data-tooltip="<%= t('common:shared_terms.add_at_least_1_question_to_publish') %>">
            <i class="bi bi-pencil"></i>
            <%= t("common:filters.draft") %>
          </span>
        <% } else { %>
            <span class="badge green-badge">
              <i class="bi bi-check"></i>
              <%= t("common:filters.published") %>
            </span>
        <% } %>
              <div>
                <button type="button" class="exclude-btn quiz-card-menu-btn open-drop-down-btn">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <div class="drop-down-menu overlay">
                  <div class="drop-down-group">
                    <button type="button" class="drop-down-item exclude-btn edit-quiz-menu-btn"
                      data-quiz-id="<%= quiz.id %>">
                      <i class="bi bi-pencil-square"></i>
                      <%= t("common:shared_terms.edit") %>
                    </button>
                    <button type="button" class="drop-down-item exclude-btn preview-quiz-menu-btn"
                      data-quiz-id="<%= quiz.id %>">
                      <i class="bi bi-eye"></i>
                      <%= t("quizzes:menu.preview") %>
                    </button>
                    <button type="button" class="drop-down-item exclude-btn duplicate-quiz-menu-btn"
                      data-quiz-id="<%= quiz.id %>">
                      <i class="bi bi-files"></i>
                      <%= t("quizzes:menu.duplicate") %>
                    </button>
                    <button type="button" class="drop-down-item exclude-btn red-btn remove-quiz-menu-btn"
                      data-quiz-id="<%= quiz.id %>">
                      <i class="bi bi-trash3"></i>
                      <%= t("quizzes:menu.remove") %>
                    </button>
                  </div>
                </div>
              </div>
      </header>
      <div class="quiz-title-container info-container">
        <label class="quiz-title-label">
          <span class="icon-box"><i class="bi bi-card-text"></i></span>
          <%= t("common:shared_terms.quiz_title") %>
        </label>
        <div class="quiz-title content">
          <bdi><%= quiz.title %></bdi>
        </div>
      </div>
      <div class="questions-count-container info-container small-container">
        <label class="questions-count-label">
          <span class="icon-box"><i class="bi bi-question-circle"></i></span>
          <%= t("common:shared_terms.questions") %>
        </label>
        <span class="count content">
          <bdi><%= quiz.questionsCount %></bdi>
        </span>
      </div>
      <div class="shared-in-container info-container">
        <label class="shared-in-label">
          <span class="icon-box"><i class="bi bi-people"></i></span>
          <%= t("quizzes:labels.shared_in") %>
        </label>
        <div class="content">
          <span class="count content has-tooltip" data-tooltip="<%= t('quizzes:labels.shared_in_tooltip') %>">
            <bdi><%= formatNumber(quiz.groupsCount) %></bdi>
              <sup><%= t("common:quiz_card.groups_abbr") %></sup>
              | <bdi><%= formatNumber(quiz.sessionsCount) %></bdi>
                <sup><%= t("common:quiz_card.sessions_abbr") %></sup>
          </span>
        </div>
      </div>
      <div class="subject-container info-container small-container">
        <label class="subject-label">
          <span class="icon-box"><i class="bi bi-book"></i></span>
          <%= t("common:shared_terms.subject") %>
        </label>
        <span class="subject content">
          <bdi><%= quiz.subject %></bdi>
        </span>
      </div>
    </div>
  <% }); %>
  <% } else { %>
      <div class="icon-wrapper">
        <div class="empty-icon-container">
          <i class="bi bi-file-earmark-plus"></i>
        </div>
        <h3><%= t("quizzes:my.empty_heading") %></h3>
        <p><%= t("quizzes:my.empty_desc") %></p>
      </div>
  <% } %>
</div>