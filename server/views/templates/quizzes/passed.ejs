<div
  data-last-visible="<%= lastVisible || '' %>"
  class="quizzes-list fade-in-template"
>
  <% if (cards && cards.length > 0) { %>
    <% cards.forEach(function(quiz) { %>
    <div class="quiz-card card-item">
      <div class="quiz-title-container info-container">
        <label class="quiz-title-label">
          <span class="icon-box"><i class="bi bi-card-text"></i></span>
          Quiz Title
        </label>
        <div class="quiz-title content"><%= quiz.title %></div>
      </div>
      <div class="score-container info-container">
        <label class="score-label">
          <span class="icon-box">
            <i class="bi bi-trophy"></i>
          </span>
          Score
        </label>
        <div class="score <%= getScoreClass(quiz.score) %> content">
          <%= quiz.score %>%
        </div>
      </div>
      <div class="group-name-container info-container">
        <label class="group-name-label">
          <span class="icon-box">
            <i class="bi bi-people"></i>
          </span>
          Group Name
        </label>
        <div class="group-name content"><%= quiz.groupName %></div>
      </div>
      <div class="submitted-at-container info-container">
        <label class="submitted-at-label">
          <span class="icon-box">
            <i class="bi bi-calendar-check"></i>
          </span>
          Submitted At
        </label>
        <div class="submitted-at content">
          <%= toReadableDate(quiz.submittedAt) %>
        </div>
      </div>
      <div class="session-name-container info-container">
        <label class="session-name-label">
          <span class="icon-box">
            <i class="bi bi-journal-bookmark"></i>
          </span>
          Session Name
        </label>
        <div class="session-name content"><%= quiz.sessionName %></div>
      </div>
      <div class="action-btns">
        <button class="view-quiz-result-btn" data-quiz-id="<%= quiz.id %>">
          <i class="bi bi-eye"></i>
          View Result
        </button>
        <button class="retake-quiz-btn" data-quiz-id="<%= quiz.id %>">
          <i class="bi bi-arrow-repeat"></i>
          Retake
        </button>
      </div>
    </div>
    <% }); %>
  <% } else { %>
    <div class="icon-wrapper">
      <div class="empty-icon-container">
        <i class="bi bi-award"></i>
      </div>
      <h3>No Passed Quizzes</h3>
      <p>You haven't completed any quizzes yet. Join a study session and take a quiz to see your achievements here!</p>
    </div>
  <% } %>
</div>
