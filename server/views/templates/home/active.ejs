<div class="main-content overview-active-session fade-in-template">
  <div class="left-container">
    <div class="session">
      <header>
        <div class="header-title">
          <i class="bi bi-book-fill"></i>
          <h2><%= t("home:active.current_session") %></h2>
        </div>
        <div class="badges">
          <span class="badge <%= session.quiz ? 'green-badge' : 'gray-badge' %>">
            <i class="bi bi-clipboard2-check-fill"></i>
            <span><%= session.quiz ? t("common:shared_terms.quiz") : t("home:active.badge_no_quiz") %></span>
          </span>
          <span class="badge <%= session.isAdmin ? 'orange-badge' : 'blue-badge' %>">
            <i class="bi <%= session.isAdmin ? 'bi-person-fill-gear' : 'bi-person-fill' %>"></i>
            <span><%= session.isAdmin ? t("common:shared_terms.host") : t("common:filters.member") %></span>
          </span>
        </div>
      </header>
      <div class="session-info">
        <div class="session-name-container info-container">
          <label class="session-name-label"><span class="icon-box">
            <i class="bi bi-clock-history"></i>
            <i class="bi bi-info-circle"></i>
          </span><%= t("home:active.session_name") %></label>
          <div class="session-name content">
          <bdi><%= session.name %></bdi>
          </div>
        </div>
        <div class="start-time-container info-container small-container">
          <label class="start-time-label"><span class="icon-box"><i class="bi bi-play-circle"></i></span><%= t("common:shared_terms.start") %></label>
          <div class="content">
            <span class="start-time">
              <bdi><%= session.startDate %></bdi>
            </span>
          </div>
        </div>

        <div class="end-time-container info-container small-container">
          <label class="end-time-label"><span class="icon-box"><i class="bi bi-stopwatch"></i></span><%= t("common:shared_terms.end") %></label>
          <div class="content">
            <span class="end-time"><bdi><%= session.endDate %></bdi></span>
          </div>
        </div>
        <div class="group-name-container info-container">
          <label class="group-name-label">
          <span class="icon-box">
            <i class="bi bi-people"></i>
            <i class="bi bi-info-circle"></i>
          </span><%= t("home:active.group_name") %></label>
          <div class="group-name content">
            <bdi><%= session.groupName %></bdi>
          </div>
        </div>
        <div class="time-left-container info-container small-container">
          <label class="left-label"><span class="icon-box"><i class="bi bi-hourglass-bottom"></i></span><%= t("home:active.elapsed") %></label>
          <div class="content">
            <span class="time-left">0<%= t("common:time.m") %></span>
          </div>
        </div>
        <div class="elapsed-time-container info-container small-container">
          <label class="elapsed-time-label"><span class="icon-box"><i class="bi bi-hourglass-top"></i></span><%= t("home:active.left") %></label>
          <div class="content">
            <span class="elapsed-time">0<%= t("common:time.m") %></span>
          </div>
        </div>
        <div class="quiz-title-container<%= !session.quiz ? ' no-quiz' : '' %> info-container">
          <label class="quiz-title-label"> 
          <span class="icon-box">
            <i class="bi bi-clipboard-check"></i>
            <i class="bi bi-info-circle"></i>
          </span><%= t("common:shared_terms.quiz_title") %></label>
          <div class="quiz-title content"><%= session.quiz ? session.quiz.title : t("home:active.no_quiz_added") %></div>
        </div>
        <div class="duration-container info-container small-container">
          <label class="duration-label"><span class="icon-box">
                <i class="bi bi-clock"></i>
              </span><%= t("common:shared_terms.duration") %></label>
          <div class="content">
            <span class="duration">
              
              <bdi><%= session.duration %></bdi>
            </span>
          </div>
        </div>
        <div class="joined-count-container info-container small-container">
          <label class="joined-count-label">
            <span class="icon-box"><i class="bi bi-person-check"></i></span>
            <%= t("common:shared_terms.joined_count") %>
          </label>
          <div class="joined-count-content">
            <span class="joined-count"><bdi><%= session.joinedCount %></bdi></span>
          </div>
        </div>
        <div class="session-description-container info-container">
          <div class="session-description-label">
            <span><%= t("home:active.session_description") %></span>
            <button type="button" class="exclude-btn expande-desc-btn">
              <i class="bi bi-chevron-expand"></i>
            </button>
          </div>
          <div class="session-description"><bdi><%= session.description %></bdi></div>
        </div>
      </div>
      <div class="btns session-action-btns">
        <button type="button" class="red-btn <%= session.isAdmin ? 'end-session' : 'leave-session' %>">
          <i class="bi bi-box-arrow-left"></i>
          <span><%= session.isAdmin ? t("common:shared_terms.end_session") : t("home:active.leave") %></span>
        </button>
      </div>
    </div>
    <div class="tasks">
      <header>
        <div class="header-title">
          <i class="bi bi-ui-checks"></i>
          <h2><%= t("common:mobile_nav.tasks") %></h2>
        </div>
      </header>
      <div class="tasks-container">
        <div class="ongoing-tasks">
          <header>
            <h3 class="ongoing"><%= t("home:active.ongoing") %></h3>
            <div class="btns">
              <button type="button" data-tooltip="<%= t('quizzes:session_overlay.scroll_to_top_tooltip') %>" class="exclude-btn scroll-to-top has-tooltip">
                <i class="bi bi-arrow-up-short"></i>
              </button>
              <button type="button" data-tooltip="<%= t('quizzes:session_overlay.collapse_all_tooltip') %>" class="exclude-btn collapse-all has-tooltip">
                <i class="bi bi-arrows-expand"></i>
              </button>
            </div>
          </header>
          <div class="tasks-list ongoing-tasks-list"></div>
        </div>
        <hr class="separator" />
        <div class="completed-tasks">
          <header>
            <h3 class="completed"><%= t("common:shared_terms.completed") %></h3>
            <div class="btns">
              <button type="button" data-tooltip="<%= t('quizzes:session_overlay.scroll_to_top_tooltip') %>" class="exclude-btn scroll-to-top has-tooltip">
                <i class="bi bi-arrow-up-short"></i>
              </button>
              <button type="button" data-tooltip="<%= t('quizzes:session_overlay.collapse_all_tooltip') %>" class="exclude-btn collapse-all has-tooltip">
                <i class="bi bi-arrows-expand"></i>
              </button>
            </div>
          </header>
          <div class="tasks-list completed-tasks-list">
            <div class="icon-wrapper completed-empty-state">
              <div class="empty-icon-container">
                <i class="bi bi-check2-circle"></i>
              </div>
              <h3><%= t("home:active.empty_completed_heading") %></h3>
              <p><%= t("home:active.empty_completed_desc") %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="right-container">
    <div class="timer-quiz-container">
      <div class="timer">
        <header>
          <div class="header-title">
            <i class="bi bi-stopwatch-fill"></i>
            <h2><%= t("home:active.timer_heading") %></h2>
