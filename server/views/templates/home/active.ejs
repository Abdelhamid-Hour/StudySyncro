<div class="main-content overview-active-session fade-in-template">
  <div class="left-container">
    <div class="session">
      <header>
        <div class="header-title">
          <i class="bi bi-book-fill"></i>
          <h2>Current Session</h2>
        </div>
        <div class="badges">
          <span class="badge <%= session.quiz ? 'green-badge' : 'gray-badge' %>">
            <i class="bi bi-clipboard2-check-fill"></i>
            <span><%= session.quiz ? 'Quiz' : 'No Quiz' %></span>
          </span>
          <span class="badge <%= session.isAdmin ? 'orange-badge' : 'blue-badge' %>">
            <i class="bi <%= session.isAdmin ? 'bi-person-fill-gear' : 'bi-person-fill' %>"></i>
            <span><%= session.isAdmin ? 'Host' : 'Member' %></span>
          </span>
        </div>
      </header>
      <div class="session-info">
        <div class="session-name-container info-container">
          <label class="session-name-label"><span class="icon-box">
            <i class="bi bi-clock-history"></i>
            <i class="bi bi-info-circle"></i>
          </span>Session name</label>
          <div class="session-name content" data-session-uid="<%- session.UID %>">
          <%= session.name %>
          </div>
        </div>
        <div class="start-time-container info-container small-container">
          <label class="start-time-label"><span class="icon-box"><i class="bi bi-play-circle"></i></span>Start</label>
          <div class="content">
            <span class="start-time" data-start-date="<%= session.startDate %>">
              <%= session.formatHoursMinutes(new Date(session.startDate)) %>
            </span>
          </div>
        </div>

        <div class="end-time-container info-container small-container">
          <label class="end-time-label"><span class="icon-box"><i class="bi bi-stopwatch"></i></span>End</label>
          <div class="content">
            <span class="end-time"><%= session.endDate %></span>
          </div>
        </div>
        <div class="group-name-container info-container">
          <label class="group-name-label">
          <span class="icon-box">
            <i class="bi bi-people"></i>
            <i class="bi bi-info-circle"></i>
          </span>Group name</label>
          <div class="group-name content" data-group-uid="<%- session.groupUID %>">
            <%= session.groupName %>
          </div>
        </div>
        <div class="time-left-container info-container small-container">
          <label class="left-label"><span class="icon-box"><i class="bi bi-hourglass-bottom"></i></span>Left</label>
          <div class="content">
            <span class="time-left">00m</span>
          </div>
        </div>
        <div class="elapsed-time-container info-container small-container">
          <label class="elapsed-time-label"><span class="icon-box"><i class="bi bi-hourglass-top"></i></span>Elapsed</label>
          <div class="content">
            <span class="elapsed-time"><%= session.millisecondsToHMFormat(session.durationInMins * 60 *
              1000) %></span>
          </div>
        </div>
        <div class="quiz-title-container info-container">
          <label class="quiz-title-label"> 
          <span class="icon-box">
            <i class="bi bi-clipboard-check"></i>
            <i class="bi bi-info-circle"></i>
          </span>Quiz title</label>
          <div class="quiz-title content"><%= session.quiz ? session.quiz.title : 'No Quiz Added To This Session' %></div>
        </div>
        <div class="duration-container info-container small-container">
          <label class="duration-label"><span class="icon-box">
                <i class="bi bi-clock"></i>
              </span>Duration</label>
          <div class="content">
            <span class="duration" data-duration-in-mins="<%= session.durationInMins %>">
              
              <%= session.millisecondsToHMFormat(session.durationInMins * 60 *
              1000) %>
            </span>
          </div>
        </div>
        <div class="joined-count-container info-container small-container">
          <label class="joined-count-label">
            <span class="icon-box"><i class="bi bi-person-check"></i></span>
            Joined Count
          </label>
          <div class="joined-count-content">
            <span class="joined-count"><%= session.joinedCount %> Members</span>
          </div>
        </div>
        <div class="session-description-container info-container">
          <div class="session-description-label">
            <span>Session Description</span>
            <button type="button" class="exclude-btn expande-desc-btn">
              <i class="bi bi-chevron-expand"></i>
            </button>
          </div>
          <div class="session-description"><%= session.description %></div>
        </div>
      </div>
      <div class="btns">
        <button type="button" class="red-btn">
          <i class="bi bi-box-arrow-left"></i>
          <span><%= session.isAdmin ? 'End Session' : 'Leave' %></span>
        </button>
      </div>
    </div>
    <div class="tasks">
      <header>
        <div class="header-title">
          <i class="bi bi-ui-checks"></i>
          <h2>Tasks</h2>
        </div>
      </header>
      <div class="tasks-container">
        <div class="ongoing-tasks">
          <header>
            <h3 class="ongoing">Ongoing</h3>
            <div class="btns">
              <button type="button" data-tooltip="Scroll To Top" class="exclude-btn scroll-to-top has-tooltip">
                <i class="bi bi-arrow-up-short"></i>
              </button>
              <button type="button" data-tooltip="Collapse All" class="exclude-btn collapse-all has-tooltip">
                <i class="bi bi-arrows-expand"></i>
              </button>
            </div>
          </header>
          <div class="tasks-list ongoing-tasks-list">
            <%_ session.tasks.map((task, index) => { %>
            <div class="task-wrapper ">
              <div <%- index === 0 
              ? 'data-tooltip="Active Task"' 
              : task instanceof Quiz 
              ? 'data-tooltip="Quiz"' 
              : '' %> class="task-box<%= task instanceof Quiz ? ' quiz-task-box' : '' %><%= index === 0 ? ' first' : '' %><%= (index === 0 || task instanceof Quiz) ? ' has-tooltip' : '' _%>
              ">
                <div class="counter">
                  <span>
                    <%= (index + 1) .toString()
                    .padStart(session.tasks.length.toString().length, '0') %>
                  </span>
                </div>
                <span class="title"><%= task.title %></span>
                <span class="duration" data-duration-in-mins="<%= task.durationInMins %>"><%= session.millisecondsToHMFormat( task.durationInMins * 60 * 1000
                  ) _%>
                </span>
                <div class="icons">
                  <button type="button" class="task-menu-btn exclude-btn">
                    <span></span>
                    <span></span>
                    <span></span>
                  </button>
                  <button type="button" data-tooltip="Show Details" class="task-down-icon exclude-btn should-fill has-tooltip">
                    <i class="bi bi-caret-down"></i>
                  </button>
                </div>
              </div>
              <div class="task-details">
                <h5>Title:</h5>
                <p><%= task.title %></p>
                <h5>Details:</h5>
                <%=task.description _%>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <hr class="separator" />
        <div class="completed-tasks">
          <header>
            <h3 class="completed">Completed</h3>
            <div class="btns">
              <button type="button" data-tooltip="Scroll To Top" class="exclude-btn scroll-to-top has-tooltip">
                <i class="bi bi-arrow-up-short"></i>
              </button>
              <button type="button" data-tooltip="Collapse All" class="exclude-btn collapse-all has-tooltip">
                <i class="bi bi-arrows-expand"></i>
              </button>
            </div>
          </header>
          <div class="tasks-list completed-tasks-list"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="right-container">
    <div class="timer-quiz-container">
      <div class="timer">
        <header>
          <div class="header-title">
            <i class="bi bi-stopwatch-fill"></i>
            <h2>Timer</h2>
          </div>
          <div class="info">
            <div class="active-task-container">
              <label>Active Task</label>
              <span>Prepare Workshop Material</span>
            </div>
            <div class="next-task-container">
              <label>Next Task</label>
              <span>Prepare Workshop Material</span>
            </div>
            <div class="up-next-container">
              <label>Up Next</label>
              <span>5min Break</span>
            </div>
          </div>
        </header>
        <div class="timer-container">
          <div class="flip-container flip-container-hours">
            <div class="flip-digit flip-hours-left-digit">
              <!-- Back of the top half -->
              <div class="flip-face flip-face-top-back">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Bottom static face -->
              <div class="flip-face flip-face-bottom">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Top animated front face (flipping down) -->
              <div class="flip-top-container">
                <div class="flip-face flip-face-top-front-back">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
                <div class="flip-face flip-face-top-front-front">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
              </div>
            </div>
            <div class="flip-digit flip-hours-right-digit">
              <!-- Back of the top half -->
              <div class="flip-face flip-face-top-back">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Bottom static face -->
              <div class="flip-face flip-face-bottom">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Top animated front face (flipping down) -->
              <div class="flip-top-container">
                <div class="flip-face flip-face-top-front-back">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
                <div class="flip-face flip-face-top-front-front">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
              </div>
            </div>
            <span class="label">HRS</span>
          </div>
          <div class="timer-separator"></div>
          <div class="flip-container flip-container-minutes">
            <div class="flip-digit flip-minutes-left-digit">
              <!-- Back of the top half -->
              <div class="flip-face flip-face-top-back">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Bottom static face -->
              <div class="flip-face flip-face-bottom">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Top animated front face (flipping down) -->
              <div class="flip-top-container">
                <div class="flip-face flip-face-top-front-back">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
                <div class="flip-face flip-face-top-front-front">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
              </div>
            </div>
            <div class="flip-digit flip-minutes-right-digit">
              <!-- Back of the top half -->
              <div class="flip-face flip-face-top-back">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Bottom static face -->
              <div class="flip-face flip-face-bottom">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Top animated front face (flipping down) -->
              <div class="flip-top-container">
                <div class="flip-face flip-face-top-front-back">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
                <div class="flip-face flip-face-top-front-front">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
              </div>
            </div>
            <span class="label">MINS</span>
          </div>
          <div class="timer-separator"></div>
          <div class="flip-container flip-container-seconds">
            <div class="flip-digit flip-seconds-left-digit">
              <!-- Back of the top half -->
              <div class="flip-face flip-face-top-back">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Bottom static face -->
              <div class="flip-face flip-face-bottom">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Top animated front face (flipping down) -->
              <div class="flip-top-container">
                <div class="flip-face flip-face-top-front-back">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
                <div class="flip-face flip-face-top-front-front">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
              </div>
            </div>
            <div class="flip-digit flip-seconds-right-digit">
              <!-- Back of the top half -->
              <div class="flip-face flip-face-top-back">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Bottom static face -->
              <div class="flip-face flip-face-bottom">
                <span>0</span>
                <div class="flip-gap flip-gap-left"></div>
                <div class="flip-gap flip-gap-right"></div>
              </div>
              <!-- Top animated front face (flipping down) -->
              <div class="flip-top-container">
                <div class="flip-face flip-face-top-front-back">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
                <div class="flip-face flip-face-top-front-front">
                  <span>0</span>
                  <div class="flip-gap flip-gap-left"></div>
                  <div class="flip-gap flip-gap-right"></div>
                </div>
              </div>
            </div>
            <span class="label">SECS</span>
          </div>
        </div>
      </div>
      <div class="quiz">
        <header>
          <div class="header-title">
            <i class="bi bi-clipboard-check-fill"></i>
            <h2>Quiz</h2>
          </div>
          <!-- <div class="badges">
            <span class="badge in-progress-badge">
              <i class="bi bi-clock-history"></i>
              In Progress
            </span>
          </div> -->
        </header>
        <div class="quiz-details">
          <div class="quiz-title-container info-container">
            <label class="quiz-title-label"><span class="icon-box">
              <i class="bi bi-clipboard-check"></i>
              <i class="bi bi-info-circle"></i>
            </span>Quiz title</label>
            <div class="quiz-title content"><%= session.quiz ? session.quiz.title : 'No Quiz Added To This Session' %></div>
          </div>
          <div class="questions-container info-container small-container">
            <label class="questions-label"><span class="icon-box"><i class="bi bi-question-circle"></i></span>Questions</label>
            <div class="questions content">
              <span ><%= session.quiz ? session.quiz.questionsCount : '--' %> Questions</span>
            </div>
          </div>
          <div class="start-in-container info-container small-container">
            <label class="start-in-label"><span class="icon-box"><i class="bi bi-play-circle"></i></span>Start In</label>
            <div class="content">
              <span class="start-time">--m</span>
            </div>
          </div>
          <div class="submitted-container info-container small-container">
            <label class="submitted-label"><span class="icon-box"><i class="bi bi-check2-all"></i></span>Submitted</label>
            <div class="submitted">
              <span class="submitted-count">-- of -- Questions</span>
              <div class="progress-back">
                <div class="progress"></div>
              </div>
            </div>
          </div>
        </div>
        <footer class="quiz-footer">
          <div class="score-container info-container">
            <label>Your Score</label>
            <span class="score">____</span>
          </div>
        </footer>
      </div>
    </div>
    <div class="chat">
      <header>
        <div class="header-title">
          <i class="bi bi-chat-text-fill"></i>
          <h2>Chat</h2>
        </div>
      </header>
      <div class="chat-messages"></div>
      <div class="input-message-container">
        <div class="icons">
          <label for="image-upload" class="should-fill">
            <i class="bi bi-image"></i>
          </label>
          <label for="file-upload">
            <i class="bi bi-paperclip"></i>
          </label>
          <div class="emoji-picker">
            <button type="button" class="exclude-btn should-fill emoji-button open-drop-down-btn">
              <i class="bi bi-emoji-smile"></i>
            </button>
            <div class="emoji-list overlay">
              <div class="categories">
                <a data-section-id="recent" class="recent should-fill">
                  <i class="bi bi-clock"></i>
                </a>
                <a data-section-id="people" class="should-fill">
                  <i class="bi bi-emoji-smile"></i>
                </a>
                <a data-section-id="animals_nature" class="should-fill">
                  <i class="bi bi-tree"></i>
                </a>
                <a data-section-id="food_drink" class="should-fill">
                  <i class="bi bi-cup"></i>
                </a>
                <a data-section-id="activity" class="should-fill">
                  <i class="bi bi-calendar"></i>
                </a>
                <a data-section-id="objects" class="should-fill">
                  <i class="bi bi-box"></i>
                </a>
                <a data-section-id="symbols" class="should-fill">
                  <i class="bi bi-heart"></i>
                </a>
                <a data-section-id="travel_places" class="should-fill">
                  <i class="bi bi-geo-alt"></i>
                </a>
                <a data-section-id="flags" class="should-fill">
                  <i class="bi bi-flag"></i>
                </a>
              </div>
              <div class="emoji-search-container">
                <div class="search-icon-container">
                  <i class="bi bi-search"></i>
                </div>
                <input type="search" placeholder="Search for emoji" id="emojis-search-input" class="emojis-search-input" />
              </div>
              <div class="emojies-sections">
                <section id="recent">
                  <h5>Recent</h5>
                  <div class="recent-emojies"></div>
                </section>
                <section id="people">
                  <h5>People</h5>
                  <div class="people-emojies"></div>
                </section>
                <section id="animals_nature">
                  <h5>Animals & Nature</h5>
                  <div class="animals-nature-emojies"></div>
                </section>
                <section id="food_drink">
                  <h5>Food & Drink</h5>
                  <div class="food-drink-emojies"></div>
                </section>
                <section id="activity">
                  <h5>Activity</h5>
                  <div class="activity-emojies"></div>
                </section>
                <section id="objects">
                  <h5>Objects</h5>
                  <div class="objects-emojies"></div>
                </section>
                <section id="symbols">
                  <h5>Symbols</h5>
                  <div class="symbols-emojies"></div>
                </section>
                <section id="travel_places">
                  <h5>Travel & Places</h5>
                  <div class="travel-places-emojies"></div>
                </section>
                <section id="flags">
                  <h5>Flags</h5>
                  <div class="flags-emojies"></div>
                </section>
              </div>
              <div id="search-result"></div>
            </div>
          </div>
          <input type="file" id="image-upload" class="file-input" accept="
          image/png,
          image/jpeg,
          image/jpg,
          image/gif,
          video/mp4,
          " multiple />
          <input multiple type="file" class="file-input" id="file-upload" accept=".pdf,
            .mp3,
            .doc,
            .docx,
            .xls,
            .xlsx,
            .ppt,
            .pptx,
            .txt,
            .rar" />
        </div>
        <textarea placeholder="Type a message" id="input-message" class="input-message"></textarea>
        <button type="button" class="send-btn exclude-btn should-fill">
          <i class="bi bi-send"></i>
        </button>
      </div>
    </div>
  </div>
</div>