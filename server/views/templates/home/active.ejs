      </div>
      <div class="quiz">
        <header>
          <div class="header-title">
            <i class="bi bi-clipboard-check-fill"></i>
            <h2><%= t("common:shared_terms.quiz") %></h2>
          </div>
          <% if (!session.isAdmin && session.quiz && session.quiz.passed && session.quiz.status !== 'completed') { %>
           <span class="quiz-note badge gray-badge"><i class="bi bi-info-circle"></i><%= t("home:active.already_passed_note") %></span>
          <% } %>
          <% if (session.quiz) { %>
           <div class="badges">
            <span class="status-badge badge <%= session.quiz.status === 'active' ? 'orange-badge' : session.quiz.status === 'completed' ? 'green-badge' : 'gray-badge' %>">
                <i class="bi <%= session.quiz.status === 'active' ? 'bi-clock-history' : session.quiz.status === 'completed' ? 'bi-check-circle' : 'bi-hourglass' %>"></i>
              <%= session.quiz.status === 'active' ? t("common:shared_texts.in_progress") : session.quiz.status === 'completed' ? t("common:shared_terms.completed") : t("common:shared_texts.pending") %>
            </span>
          </div>
          <% } %>
        </header>
        <div class="quiz-details">
          <div class="quiz-title-container<%= !session.quiz ? ' no-quiz' : '' %> info-container">
            <label class="quiz-title-label"><span class="icon-box">
              <i class="bi bi-clipboard-check"></i>
              <i class="bi bi-info-circle"></i>
            </span><%= t("common:shared_terms.quiz_title") %></label>
            <div  class="quiz-title content"><%= session.quiz ? session.quiz.title : t("home:active.no_quiz_added") %></div>
          </div>
          <div class="questions-container<%= !session.quiz ? ' no-quiz' : '' %> info-container small-container">
            <label class="questions-label"><span class="icon-box"><i class="bi bi-question-circle"></i></span><%= t("common:shared_terms.questions") %></label>
            <div class="questions content">
              <span ><%= session.quiz ? t("home:active.questions_count", { count: session.quiz.questionsCount }) : '-- ' + t("common:shared_terms.questions") %></span>
            </div>
          </div>
          <div class="start-in-container<%= !session.quiz ? ' no-quiz' : '' %> info-container small-container">
            <label class="start-in-label"><span class="icon-box"><i class="bi bi-play-circle"></i></span><%= t("home:active.start_in") %></label>
            <div class="content">
              <span class="start-time">--<%= t('common:time.m') %></span>
            </div>
          </div>
          <% if (!session.isAdmin) { %>
           <div class="submitted-container<%= !session.quiz ? ' no-quiz' : '' %> info-container small-container">
            <label class="submitted-label"><span class="icon-box"><i class="bi bi-check2-all"></i></span><%= t("home:active.submitted") %></label>
            <div class="submitted">
              <span class="submitted-count"><%= session.quiz && session.quiz.passed ? t("home:active.submitted_progress", { submitted: session.quiz.submittedCount, total: session.quiz.questionsCount }) : '-- / --' %></span>
              <div class="progress-back">
                <div style="width: <%= session.quiz && session.quiz.passed ? session.quiz.percentage : '0' %>;" class="progress"></div>
              </div>
            </div>
          </div>
          <% } %>
        </div>
        <footer class="quiz-footer">
          <% if (!session.isAdmin && session.quiz && session.quiz.passed) { %>
           <div class="score-container<%= !session.quiz ? ' no-quiz' : '' %> info-container">
            <label><%= t("common:shared_texts.your_score") %></label>
            <span class="score"><%= session.quiz && session.quiz.passed ? `${session.quiz.percentage}%` : '_____' %></span>
          </div>
          <% } %>
          <% if (session.quiz) { %>
            <% if ((session.isAdmin && session.quiz.status === 'completed') || (!session.isAdmin && (session.quiz.status === 'completed' || session.quiz.passed))) { %>
              <div class="action-buttons">
                <% if (!session.isAdmin) { %>
                  <button
                  type="button"
                  class="retake-btn"
                >
                  <i class="bi bi-arrow-clockwise"></i>
                  <%= t("common:shared_terms.retake_quiz") %>
                </button>
                <% } %>
                <button
                type="button"
                class="result<%= session.isAdmin ? 's' : '' %>-btn should-fill"
              >
                <i class="bi bi-eye"></i>
                <%= session.isAdmin ? t("common:shared_terms.view_results") : t("common:shared_terms.view_result") %>
                </button>
              </div>
            <% } %>
          <% } %>
        </footer>
      </div>
    </div>
    <div class="chat">
      <header>
        <div class="header-title">
          <i class="bi bi-chat-text-fill"></i>
          <h2><%= t("common:mobile_nav.chat") %></h2>
        </div>
      </header>
      <div data-last-visible="<%= lastVisible %>" data-last-message-id="<%= messages[messages.length - 1]?.id || '' %>" class="chat-messages">
        <% if (messages && messages.length > 0) { %>
        
          <% messages.forEach((msg, index) => {
              const isFirst = !messages[index - 1] || (messages[index - 1].sender.id !== msg.sender.id);
              const isLast = !messages[index + 1] || (messages[index + 1].sender.id !== msg.sender.id); %>

            <% if (isFirst) { %>
              <div class="message-<%= msg.isSender ? 'sent' : 'received' %>">
              <% if (!msg.isSender) { %>
                <div class="avatar">
                  <% if (msg.sender.photoURL) { %>
                    <img src="<%= msg.sender.photoURL %>" alt="<%= t('common:avatar_alt') %>" />
                    <% } else { %>
                      <i class="bi bi-person-circle"></i>
                      <% } %>
                </div>
                <% } %>
                
                <div class="messages">
            <% } %>
                  <div class="<%= isFirst ? 'first-' : '' %>message-<%= msg.isSender ? 'sent' : 'received' %>-text card-item"
                      data-message-id="<%= msg.id || '' %>" <%- msg.content.fileStatus && msg.content.fileStatus !== 'uploaded' ? `data-local-id="${msg.localId || ''}"` : '' %> >
                    <% if (!msg.isSender && isFirst) { %>
                      <span data-sender-id="<%= msg.sender.id %>" class="username"><bdi><%= msg.sender.fullName %></bdi></span>
                    <% } %>

                    <% if (msg.content.text) { %>
                      <p><%= msg.content.text %></p>
                    <% } else {
                      const file = msg.content;  
                      const formatFileSize = (sizeInBytes) => {
                            if (sizeInBytes < 1024) {
                              return `${sizeInBytes} bytes`;
                            }
                            const kb = sizeInBytes / 1024;
                            if (kb < 1024) {
                              return `${kb.toFixed(2)} KB`;
                            }
                            const mb = kb / 1024;
                            if (mb < 1024) {
                              return `${mb.toFixed(2)} MB`;
                            }
                      }
                      const ext = file.fileName.split('.').pop();
                      const fileIconClass = `bi bi-filetype-${ext}`;
                      const formattedSize = formatFileSize(file.fileSize);
                      const isImage = file.fileType.startsWith('image/');
                      const isVideo = file.fileType.startsWith('video/');
                      const isAudio = file.fileType.startsWith('audio/');
                    %>
                      <% if (isImage || isVideo) { %>
                        <div class="media-message message-media-preview">
                          <div class="media-div">
                            <% if (isImage) { %>
                              <img src="<%= file.filePath %>" alt="<%= file.fileName %>" />
                            <% } else if (isVideo) { %>
                              <video src="<%= file.filePath %>" <%- file.fileStatus === 'uploaded' ? "controls" : "" %>></video>
                            <% } %>
                          </div>
                        <% if (file.fileStatus !== 'uploaded') { %>
                          <button type="button" class="re-send-btn small-btn"><i class="bi bi-upload"></i><%= t("common:actions.retry") %></button>
                        <% } %>
                        <% if (file.fileStatus === 'uploaded') { %>
                          <button type="button" class="expand-btn"><i class="bi bi-arrows-fullscreen"></i></button>
                          <a class="download-btn button" href="<%= file.filePath %>" download="<%= file.fileName %>">
                            <i class="bi bi-download"></i>
                          </a>
                        <% } %>
                        </div>
                      <% } else if (isAudio) { %>
                        <div class="media-message audio-player">
                          <button type="button" class="play-btn exclude-btn should-fill">
                            <i class="bi bi-play"></i>
                          </button>

                          <div class="progress-container">
                            <div class="progress-bar"></div>
                          </div>

                          <span class="time">00:00</span>
                          <button class="exclude-btn play-back-rate">1x</button>

                          <audio src="<%= file.filePath %>"></audio>

                        <% if (file.fileStatus !== 'uploaded') { %>
                          <button type="button" class="re-send-btn small-btn"><i class="bi bi-upload"></i></button>
                        <% } %>
                        <% if (file.fileStatus === 'uploaded') { %>
                          <a class="download-btn button" href="<%= file.filePath %>" download="<%= file.fileName %>">
                            <i class="bi bi-download"></i>
                          </a>
                        <% } %>
                        </div>

                      <% } else { %>
                        <div class="media-message file-preview">
                          <div class="file-thumbnail">
                            <i class="<%= fileIconClass %>"></i>
                          </div>
                          <div class="file-details">
                            <button class="exclude-btn file-name"><%= file.fileName %></button>
                            <span class="file-size"><%= formattedSize %></span>
                          </div>

                        <% if (file.fileStatus !== 'uploaded') { %>
                          <button type="button" class="re-send-btn small-btn"><i class="bi bi-upload"></i></button>
                        <% } %>
                        <% if (file.fileStatus === 'uploaded') { %>
                          <a class="download-btn button" href="<%= file.filePath %>" download="<%= file.fileName %>">
                            <i class="bi bi-download"></i>
                          </a>
                        <% } %>
                        </div>
                      <% } %>
                    <% } %>

                    <span class="message-info">
                      <%= formatHoursMinutes(Number(msg.timestamp)) %>
                      <% if (msg.isSender && (msg.content.fileStatus === 'uploaded' || msg.content.text)) { %>
                        <i class="bi bi-check"></i>
                      <% } %>
                      <% if (msg.isSender && msg.content.fileStatus && msg.content.fileStatus !== 'uploaded') { %>
                        <i class="bi bi-exclamation-circle"></i>
                      <% } %>
                    </span>
                  </div>
            <% if (isLast) { %>
                </div>
              </div>
            <% } %>
          <% }); %>
        <% } %>
      </div>
      <div class="input-message-container">
        <span class="newline-hint"><%= t("api:shift_enter_for_new_line") %></span>
        <div class="icons">
          <label for="image-upload" class="should-fill">
            <i class="bi bi-image"></i>
          </label>
          <label for="file-upload">
            <i class="bi bi-paperclip"></i>
          </label>
          <div class="emoji-picker">
            <button type="button" class="exclude-btn should-fill emoji-button open-drop-down-btn">
              <i class="bi bi-emoji-smile"></i>
            </button>
            <div class="emoji-list overlay">
              <div class="categories">
                <a data-section-id="recent" class="recent should-fill">
                  <i class="bi bi-clock"></i>
                </a>
                <a data-section-id="people" class="should-fill">
                  <i class="bi bi-emoji-smile"></i>
                </a>
                <a data-section-id="animals_nature" class="should-fill">
                  <i class="bi bi-tree"></i>
                </a>
                <a data-section-id="food_drink" class="should-fill">
                  <i class="bi bi-cup"></i>
                </a>
                <a data-section-id="activity" class="should-fill">
                  <i class="bi bi-calendar"></i>
                </a>
                <a data-section-id="objects" class="should-fill">
                  <i class="bi bi-box"></i>
                </a>
                <a data-section-id="symbols" class="should-fill">
                  <i class="bi bi-heart"></i>
                </a>
                <a data-section-id="travel_places" class="should-fill">
                  <i class="bi bi-geo-alt"></i>
                </a>
                <a data-section-id="flags" class="should-fill">
                  <i class="bi bi-flag"></i>
                </a>
              </div>
              <div class="emoji-search-container">
                <div class="search-icon-container">
                  <i class="bi bi-search"></i>
                </div>
                <input type="search" placeholder="<%= t('common:shared_terms.search_for_emoji') %>" id="emojis-search-input" class="emojis-search-input" />
              </div>
              <div class="emojies-sections">
                <section id="recent">
                  <h5><%= t("common:time.recent") %></h5>
                  <div class="recent-emojies"></div>
                </section>
                <section id="people">
                  <h5><%= t("common:shared_terms.people") %></h5>
                  <div class="people-emojies"></div>
                </section>
                <section id="animals_nature">
                  <h5><%= t("common:shared_terms.animals_nature") %></h5>
                  <div class="animals-nature-emojies"></div>
                </section>
                <section id="food_drink">
                  <h5><%= t("common:shared_terms.food_drink") %></h5>
                  <div class="food-drink-emojies"></div>
                </section>
                <section id="activity">
                  <h5><%= t("common:shared_terms.activity") %></h5>
                  <div class="activity-emojies"></div>
                </section>
                <section id="objects">
                  <h5><%= t("common:shared_terms.objects") %></h5>
                  <div class="objects-emojies"></div>
                </section>
                <section id="symbols">
                  <h5><%= t("common:shared_terms.symbols") %></h5>
                  <div class="symbols-emojies"></div>
                </section>
                <section id="travel_places">
                  <h5><%= t("common:shared_terms.travel_places") %></h5>
                  <div class="travel-places-emojies"></div>
                </section>
                <section id="flags">
                  <h5><%= t("common:shared_terms.flags") %></h5>
                  <div class="flags-emojies"></div>
                </section>
              </div>
              <div id="search-result"></div>
            </div>
          </div>
          <input type="file" id="image-upload" class="file-input" accept="
          image/png,
          image/jpeg,
          image/jpg,
          image/gif,
          video/mp4,
          " multiple />
          <input multiple type="file" class="file-input" id="file-upload" accept=".pdf,
            .mp3,
            .doc,
            .docx,
            .xls,
            .xlsx,
            .ppt,
            .pptx,
            .txt,
            .rar" />
        </div>
        <textarea placeholder="<%= t('common:shared_terms.type_a_message') %>" id="input-message" class="input-message"></textarea>
        <button type="button" class="send-btn exclude-btn should-fill">
          <i class="bi bi-send"></i>
        </button>
      </div>
    </div>
  </div>
</div>