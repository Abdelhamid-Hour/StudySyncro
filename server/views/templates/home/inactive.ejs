<div class="overview-session-inactive fade-in-template">
  <div class="ready-message-container">
    <div class="ready-message">
      <h2><%= t("home:inactive.ready_heading") %></h2>
      <p>
        <%= t("home:inactive.ready_desc") %>
      </p>
    </div>
  </div>
  <div class="content-blocks">
    <section class="recent-messages">
      <header>
        <h2><%= t("common:mobile_nav.recent_messages") %></h2>
        <p><%= t("home:inactive.recent_messages_sub") %></p>
      </header>
      <div class="messages-container" data-last-visible="<%= lastVisible || '' %>">
        <% if (recentMessages && recentMessages.length) { %>
          <% recentMessages.forEach(msg => { %>
            <% const hasUnread = msg.hasUnreadMessages && msg.unreadCount > 0; %>
            <div class="recent-message card-item <%= hasUnread ? 'has-unread' : '' %>" data-group-id="<%= msg.groupId || '' %>" data-last-update="<%= msg.lastUpdate || 0 %>" data-unread-count="<%= msg.unreadCount || 0 %>">
              <header>
                <div class="profile-info">
                  <% const photoURL = msg.lastMessage?.senderPhotoURL || msg.lastMessage?.photoURL || msg.senderPhotoURL || msg.photoURL; %>
                  <% if (photoURL) { %>
                    <img src="<%= photoURL %>" alt="" class="icon" />
                  <% } else { %>
                    <i class="bi bi-person-circle icon"></i>
                  <% } %>
                  <div class="details">
                    <span class="user"><bdi><%= msg.lastMessage?.senderName || msg.lastMessageSender || "Someone" %></bdi></span>
                    <span class="group"><bdi><%= msg.groupName || "Study Group" %></bdi></span>
                  </div>
                </div>
                <div class="meta-info">
                  <span class="timestamp"><%= formatTimeAgo(msg.lastUpdate, typeof t !== 'undefined' ? t : null) %></span>
                  <% if (hasUnread) { %>
                    <span class="unread-count blue-badge badge"><%= t("home:inactive.unread_messages_count", { count: msg.unreadCount }) %></span>
                  <% } %>
                </div>
              </header>
              <p class="text-message">
                <bdi><%= msg.lastMessage?.text || msg.lastMessageText || t("common:shared_texts.no_messages_yet") %></bdi>
              </p>
              <div class="action-buttons" data-group-id="<%= msg.groupId || '' %>">
                <button type="button" class="should-fill reply-group">
                  <i class="bi bi-reply"></i>
                  <%= t("common:shared_texts.reply_in_group") %>
                </button>
                <button type="button" class="should-fill reply">
                  <i class="bi bi-reply"></i>
                  <%= t("common:shared_texts.reply") %>
                </button>
                <% if (hasUnread) { %>
                <button type="button" class="mark-read">
                  <i class="bi bi-check2-all"></i>
                  <%= t("common:shared_texts.mark_as_read") %>
                </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="icon-wrapper">
            <div class="empty-icon-container">
              <i class="bi bi-chat-text-fill"></i>
            </div>
            <h3><%= t("common:shared_texts.no_messages_yet") %></h3>
            <p><%= t("common:shared_texts.no_recent_messages_yet_join_or") %></p>
          </div>
        <% } %>
      </div>
    </section>
    <section class="active-sessions">
      <header>
        <div class="header-text">
          <h2><%= t("common:mobile_nav.active_sessions") %></h2>
          <p><%= t("home:inactive.active_sessions_sub") %></p>
        </div>
        <div class="active-sessions-search search">
          <div class="search-icon-container">
            <i class="bi bi-search"></i>
          </div>
          <input
            type="search"
            id="active-sessions-search-input"
            placeholder="<%= t('home:inactive.search_placeholder') %>"
            autocomplete="off"
          />
        </div>
      </header>
      <div class="sessions-container">
        <% if (availableSessions.length) { %>
          <% availableSessions.forEach(session=> { %>
            <div class="active-session">
              <header>
                <div class="session-info">
                  <h3 class="session-name">
                    <bdi><%= session.name %></bdi>
                      <span class="joined-count badge simple-badge">
                        <span class="joined-count-value">
                          <%= t("home:inactive.joined_users_count", { count: session.joinedCount }) %>
                        </span>
                      </span>
                  </h3>
                  <span class="group badge">
                    <i class="bi bi-book-fill"></i>
                    <bdi><%= session.groupName %></bdi>
                  </span>
                </div>
                <div class="meta-info">
                  <span class="badge blue-badge">
                    <i class="bi bi-clock-fill"></i>
                    <%= t("common:shared_terms.duration") %>
                    <span class="duration">
                      <bdi><%= session.duration %></bdi>
                    </span>
                  </span>
                  <span class="badge simple-badge">
                    <i class="bi bi-list-task"></i>
                    <%= t("home:inactive.tasks_count", { count: session.tasksCount }) %>
                  </span>
                </div>
              </header>
              <p class="session-description">
                <bdi><%= session.description %></bdi>
              </p>
              <footer class="footer">
                <div class="footer-meta-info">
                  <span class="badge green-badge">
                    <i class="bi bi-play-circle"></i>
                    <%= t("common:shared_texts.start_at") %>
                    <span class="duration">
                      <bdi><%= session.startTime %></bdi>
                    </span>
                  </span>
                  <span class="badge orange-badge">
                    <i class="bi bi-stopwatch"></i>
                    <%= t("common:shared_texts.end_at") %>
                    <span class="duration">
                      <bdi><%= session.endTime %></bdi>
                    </span>
                  </span>
                </div>
                <div class="action-buttons" data-session-id="<%= session.id %>">
                  <button type="button" class="join-session blue-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <%= t("common:shared_terms.join_session") %>
                  </button>
                  <button type="button" class="should-fill view-details">
                    <i class="bi bi-info-circle"></i>
                    <%= t("common:shared_texts.view_details") %>
                  </button>
                </div>
              </footer>
            </div>
            <% }); %>
              <% } else { %>
                <div class="icon-wrapper">
                  <div class="empty-icon-container">
                    <i class="bi bi-clock-history"></i>
                  </div>
                  <h3><%= t("common:shared_texts.no_active_sessions") %></h3>
                  <p><%= t("common:shared_texts.there_are_no_study_sessions_cu") %></p>
                </div>
                <% } %>
      </div>
    </section>
  </div>
</div>
