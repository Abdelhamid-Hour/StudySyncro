<div class="overview-session-inactive fade-in-template">
  <div class="ready-message-container">
    <div class="ready-message">
      <h2>Ready to start learning together?</h2>
      <p>
        Join a study session to connect with peers, participate in discussions,
        and enhance your learning experience. StudyHype makes collaborative
        learning easy and effective!
      </p>
    </div>
  </div>
  <div class="content-blocks">
    <section class="recent-messages">
      <header>
        <h2>Recent Messages</h2>
        <p>Latest conversations from your study groups</p>
      </header>
      <div class="messages-container" data-last-visible="<%= lastVisible || '' %>">
        <% if (recentMessages && recentMessages.length) { %>
          <% recentMessages.forEach(msg => { %>
            <% const hasUnread = msg.hasUnreadMessages && msg.unreadCount > 0; %>
            <div class="recent-message card-item <%= hasUnread ? 'has-unread' : '' %>" data-group-id="<%= msg.groupId || '' %>" data-last-update="<%= msg.lastUpdate || 0 %>">
              <header>
                <div class="profile-info">
                  <% const photoURL = msg.lastMessage?.senderPhotoURL || msg.lastMessage?.photoURL || msg.senderPhotoURL || msg.photoURL; %>
                  <% if (photoURL) { %>
                    <img src="<%= photoURL %>" alt="avatar" class="icon" />
                  <% } else { %>
                    <i class="bi bi-person-circle icon"></i>
                  <% } %>
                  <div class="details">
                    <span class="user"><%= msg.lastMessage?.senderName || msg.lastMessageSender || "Someone" %></span>
                    <span class="group"><%= msg.groupName || "Study Group" %></span>
                  </div>
                </div>
                <div class="meta-info">
                  <span class="timestamp"><%= formatTimeAgo(msg.lastUpdate) %></span>
                  <% if (hasUnread) { %>
                    <span class="unread-count blue-badge badge"><%= msg.unreadCount %> New Message<%= msg.unreadCount > 1 ? "s" : "" %></span>
                  <% } %>
                </div>
              </header>
              <p class="text-message">
                <%= msg.lastMessage?.text || msg.lastMessageText || "No messages yet" %>
              </p>
              <div class="action-buttons" data-group-id="<%= msg.groupId || '' %>">
                <button type="button" class="should-fill reply-group">
                  <i class="bi bi-reply"></i>
                  Reply In Group
                </button>
                <button type="button" class="should-fill reply">
                  <i class="bi bi-reply"></i>
                  Reply
                </button>
                <% if (hasUnread) { %>
                <button type="button" class="mark-read">
                  <i class="bi bi-check2-all"></i>
                  Mark as read
                </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="icon-wrapper">
            <div class="empty-icon-container">
              <i class="bi bi-chat-text-fill"></i>
            </div>
            <h3>No Messages Yet</h3>
            <p>No recent messages yet. Join or create a study group to start collaborating and sharing messages!</p>
          </div>
        <% } %>
      </div>
    </section>
    <section class="active-sessions">
      <header>
        <div class="header-text">
          <h2>Active Sessions</h2>
          <p>Ongoing study sessions you can join now</p>
        </div>
        <div class="active-sessions-search search">
          <div class="search-icon-container">
            <i class="bi bi-search"></i>
          </div>
          <input
            type="search"
            id="active-sessions-search-input"
            placeholder="Search by session or group name"
            autocomplete="off"
          />
        </div>
      </header>
      <div class="sessions-container">
        <% if (availableSessions.length) { %>
          <% availableSessions.forEach(session=> { %>
            <div class="active-session">
              <header>
                <div class="session-info">
                  <h3 class="session-name">
                    <%= session.name %>
                      <span class="joined-count badge simple-badge">
                        <span class="joined-count-value">
                          <%= session.joinedCount %>
                        </span>
                        Joined Users
                      </span>
                  </h3>
                  <span class="group badge">
                    <i class="bi bi-book-fill"></i>
                    <%= session.groupName %>
                  </span>
                </div>
                <div class="meta-info">
                  <span class="badge blue-badge">
                    <i class="bi bi-clock-fill"></i>
                    Duration
                    <span class="duration">
                      <%= session.duration %>
                    </span>
                  </span>
                  <span class="badge simple-badge">
                    <i class="bi bi-list-task"></i>
                    <%= session.tasksCount %> Tasks
                  </span>
                </div>
              </header>
              <p class="session-description">
                <%= session.description %>
              </p>
              <footer class="footer">
                <div class="footer-meta-info">
                  <span class="badge green-badge">
                    <i class="bi bi-play-circle"></i>
                    Start At:
                    <span class="duration">
                      <%= session.startTime %>
                    </span>
                  </span>
                  <span class="badge orange-badge">
                    <i class="bi bi-stopwatch"></i>
                    End At:
                    <span class="duration">
                      <%= session.endTime %>
                    </span>
                  </span>
                </div>
                <div class="action-buttons" data-session-id="<%= session.id %>">
                  <button type="button" class="join-session blue-btn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Join Session
                  </button>
                  <button type="button" class="should-fill view-details">
                    <i class="bi bi-info-circle"></i>
                    View Details
                  </button>
                </div>
              </footer>
            </div>
            <% }); %>
              <% } else { %>
                <div class="icon-wrapper">
                  <div class="empty-icon-container">
                    <i class="bi bi-clock-history"></i>
                  </div>
                  <h3>No Active Sessions</h3>
                  <p>There are no study sessions currently active. You can start one or wait for others to join.</p>
                </div>
                <% } %>
      </div>
    </section>
  </div>
</div>