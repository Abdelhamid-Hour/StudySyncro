<% if (typeof isStandalone !== 'undefined' && isStandalone) { %>
<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title><%= statusCode %> - <%= statusMessage %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Fonts & Bootstrap Icons -->
  <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" as="style" id="font-arabic-preload" />
  <% } else { %>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" as="style" id="font-inter-preload" />
  <% } %>
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" as="style" id="font-icons-preload" />
  <script nonce="<%= nonce %>">
    var interFont = document.getElementById('font-inter-preload');
    if (interFont) interFont.rel = 'stylesheet';
    document.getElementById('font-icons-preload').rel = 'stylesheet';
    var arabicFont = document.getElementById('font-arabic-preload');
    if (arabicFont) arabicFont.rel = 'stylesheet';
  </script>
  <noscript>
    <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" id="font-arabic" />
    <% } else { %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" id="font-inter" />
    <% } %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" id="font-icons" />
  </noscript>
  <link rel="stylesheet" href="/main_assets/css/variables_and_fonts.css" />
  <link rel="stylesheet" href="/main_assets/css/styles.css" />
  <link rel="stylesheet" href="/app/assets/error/css/styles.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: var(--background-color, #ebebeb);
      color: var(--primary-text-color, black);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>
<% } %>

<div class="error-page-wrapper fade-in-template">
  <div class="error-page-card">
    <div class="error-badge">
      <span class="badge-dot"></span>
      <span><bdi><%= statusCode %> - <%= statusMessage %></bdi></span>
    </div>
    <div class="icon-container">
      <i class="bi <%= iconClass || 'bi-exclamation-triangle' %>"></i>
    </div>
    <h1 class="error-page-title"><bdi><%= statusMessage %></bdi></h1>
    <p class="error-page-description">
      <bdi><%= description %></bdi>
    </p>
    <div class="error-page-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/app/home" class="button blue-btn home-btn">
          <i class="bi bi-house-door-fill"></i>
          <span><%= typeof t !== 'undefined' ? t("common:error.back_to_dashboard") : "Back to Dashboard" %></span>
        </a>
      <% } else { %>
        <a href="/login" class="button blue-btn">
          <i class="bi bi-box-arrow-in-right"></i>
          <span><%= typeof t !== 'undefined' ? t("common:error.go_to_login") : "Go to Login" %></span>
        </a>
      <% } %>
      <button type="button" class="gray-btn back-btn" onclick="history.back()">
        <i class="bi bi-arrow-left"></i>
        <span><%= typeof t !== 'undefined' ? t("common:error.go_back") : "Go Back" %></span>
      </button>
    </div>
  </div>
</div>

<% if (typeof isStandalone !== 'undefined' && isStandalone) { %>
</body>
</html>
<% } %>

