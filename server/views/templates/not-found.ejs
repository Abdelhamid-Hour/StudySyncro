<% if (typeof isStandalone !== 'undefined' && isStandalone) { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 - Page Not Found</title>
  <script>
    (function() {
      try {
        var theme = localStorage.getItem("theme") || "light";
        document.documentElement.setAttribute("data-theme", theme);
      } catch(e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/main_assets/css/variables_and_fonts.css" />
  <link rel="stylesheet" href="/main_assets/css/styles.css" />
  <link rel="stylesheet" href="/app/assets/not-found/css/styles.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: var(--background-color, #ebebeb);
      color: var(--primary-text-color, black);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>
<% } %>

<div class="not-found-wrapper fade-in-template">
  <div class="not-found-card">
    <div class="error-badge">
      <span class="badge-dot"></span>
      <span>404 ERROR</span>
    </div>
    <div class="icon-container">
      <i class="bi bi-compass"></i>
    </div>
    <h1 class="not-found-title">Page Not Found</h1>
    <p class="not-found-description">
      We couldn't find the page you are looking for. It might have been removed, renamed, or did not exist in the first place.
    </p>
    <div class="not-found-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/app/home" class="button blue-btn home-btn">
          <i class="bi bi-house-door-fill"></i>
          <span>Back to Dashboard</span>
        </a>
      <% } else { %>
        <a href="/login" class="button blue-btn">
          <i class="bi bi-box-arrow-in-right"></i>
          <span>Go to Login</span>
        </a>
      <% } %>
      <button type="button" class="gray-btn back-btn" onclick="history.back()">
        <i class="bi bi-arrow-left"></i>
        <span>Go Back</span>
      </button>
    </div>
  </div>
</div>

<% if (typeof isStandalone !== 'undefined' && isStandalone) { %>
</body>
</html>
<% } %>
