<div class="settings-wrapper fade-in-template">
  <div class="settings-content">
    <header class="settings-header">
      <h2><%= t("settings:title") %></h2>
      <div class="tabs">
        <label class="exclude-btn active tab profile-tab">
          <input type="radio" name="tab" class="profile" checked />
          <%= t("settings:tabs.personal_info") %>
        </label>
        <label class="exclude-btn tab email-tab">
          <input type="radio" name="tab" class="email" />
          <%= t("settings:tabs.email_address") %>
        </label>
        <label class="exclude-btn tab password-tab">
          <input type="radio" name="tab" class="password" />
          <%= t("settings:tabs.password") %>
        </label>
        <label class="exclude-btn tab delete-account-tab">
          <input type="radio" name="tab" class="delete-account" />
          <%= t("settings:tabs.close_account") %>
        </label>
      </div>
    </header>

    <div class="content">
      <!-- Close Account -->
      <div class="delete-account-tab-content tab-content">
        <header>
          <h3><%= t("settings:close_account.heading") %></h3>
          <span><%= t("settings:close_account.sub") %></span>
        </header>
        <div class="settings-warning-block">
          <h4>
            <i class="bi bi-exclamation-triangle-fill"></i>
            <%= t("settings:close_account.warning_title") %>
          </h4>
          <span>
            <%= t("settings:close_account.warning_desc") %>
          </span>
        </div>
        <form class="delete-account-form">
          <div class="password-field-container">
            
            <% if (canChangePassword && canChangeEmail) { %>
             <label for="password-delete"><%= t("settings:close_account.password_label") %></label>
              <div class="field-container password-field">
                <div class="field-icon-container">
                  <span class="icon-box">
                    <i class="bi bi-lock"></i>
                  </span>
                </div>
                <input
                  type="password"
                  id="password-delete"
                  maxlength="16"
                  name="password"
                  class="input"
                  placeholder="<%= t("settings:close_account.password_placeholder") %>"
                />
                <label class="eye-icon">
                  <input type="checkbox" />
                  <i class="bi bi-eye-fill"></i>
                  <div><hr /></div>
                </label>
              </div>
            <% } %>

            <label class="container">
              <input type="checkbox" class="confirmation-input" />
              <svg viewBox="0 0 64 64" height="2em" width="2em">
                <path
                  d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16"
                  pathLength="575.0541381835938"
                  class="path"
                ></path>
              </svg>
              <%= t("settings:close_account.confirm_checkbox") %>
            </label>
          </div>

          <button type="submit" class="red-btn delete-account-btn">
            <i class="bi bi-trash3"></i>
            <%= t("settings:close_account.submit_btn") %>
          </button>
        </form>
      </div>
      <!-- Password -->
      <div class="password-tab-content tab-content">
        <header>
          <h3><%= canChangePassword ? t("settings:password.heading_change") : t("settings:password.heading_add") %></h3>
          <span><%= t("settings:password.sub") %></span>
        </header>
        <form class="password-form">

          <% if (canChangePassword && canChangeEmail) { %>
           <label for="current-password"><%= t("settings:password.current_label") %></label>
            <div class="field-container current-password-field">
              <div class="field-icon-container">
                <span class="icon-box">
                  <i class="bi bi-lock"></i>
                </span>
              </div>
              <input
                type="password"
                maxlength="16"
                id="current-password"
                name="current-password"
                class="input"
                placeholder="<%= t("settings:password.current_placeholder") %>"
              />
              <label class="eye-icon">
                <input type="checkbox" />
                <i class="bi bi-eye-fill"></i>
                <div><hr /></div>
              </label>
            </div>
          <% } %>

          <label for="new-password"><%= t("settings:password.new_label") %></label>
          <div class="field-container new-password-field">
            <div class="field-icon-container">
              <span class="icon-box">
                <i class="bi bi-lock"></i>
              </span>
            </div>
            <input
              type="password"
              maxlength="16"
              id="new-password"
              name="new-password"
              class="input"
              placeholder="<%= t("settings:password.new_placeholder") %>"
            />
            <label class="eye-icon">
              <input type="checkbox" />
              <i class="bi bi-eye-fill"></i>
              <div><hr /></div>
            </label>
          </div>

          <label for="confirm-password"><%= t("settings:password.confirm_label") %></label>
          <div class="field-container confirm-password-field">
            <div class="field-icon-container">
              <span class="icon-box">
                <i class="bi bi-lock"></i>
              </span>
            </div>
            <input
              type="password"
              maxlength="16"
              id="confirm-password"
              name="confirm-password"
              class="input"
              placeholder="<%= t("settings:password.confirm_placeholder") %>"
            />
            <label class="eye-icon">
              <input type="checkbox" />
              <i class="bi bi-eye-fill"></i>
              <div><hr /></div>
            </label>
          </div>

          <button type="submit" class="<%= canChangePassword ? "modify" : "add" %>-btn blue-btn">
            <i class="bi bi-pencil"></i>
            <%= canChangePassword ? t("settings:password.submit_change_btn") : t("settings:password.submit_add_btn") %>
          </button>
        </form>
      </div>
      <!-- Email Address -->
      <div class="email-tab-content tab-content">
        <header>
          <h3><%= canChangeEmail ? t("settings:email.heading_change") : t("settings:email.heading_add") %></h3>
          <span><%= canChangeEmail ? t("settings:email.sub_change") : t("settings:email.sub_add") %></span>
        </header>
        <form class="email-form">
          
          <div class="email-field-container">
            <label for="email"><%= t("settings:email.label") %></label>
            <div class="field-container email-field">
              <div class="field-icon-container">
                <span class="icon-box">
                  <i class="bi bi-envelope"></i>
                </span>
              </div>
              <input
                type="text"
                id="email"
                name="email"
                class="input"
                value="<%= email || "" %>"
                placeholder="<%= t("settings:email.placeholder") %>"
                readonly
              />
            </div>
          </div>

          <% if (canChangePassword && canChangeEmail) { %>
          <div class="password-ckeck-field hidden">
            <label for="password-email"><%= t("settings:email.current_password_label") %></label>
            <div class="field-container password-field">
              <div class="field-icon-container">
                <span class="icon-box">
                  <i class="bi bi-lock"></i>
                </span>
              </div>
              <input
                type="password"
                id="password-email"
                maxlength="16"
                name="password"
                class="input"
                placeholder="<%= t("settings:email.current_password_placeholder") %>"
              />
              <label class="eye-icon">
                <input type="checkbox" />
                <i class="bi bi-eye-fill"></i>
                <div><hr /></div>
              </label>
            </div>
          </div>
          <% } %>

          <% if (canChangeEmail || canAddEmail) { %>
           <div class="action-btns">
            <button type="<%= canAddEmail || canChangeEmail && !canChangePassword ? "submit" : "button" %>" class="blue-btn <%= canChangePassword && canChangeEmail ? "modify" : canChangeEmail ? "submit-modification" : "add" %>-btn">
              <i class="bi bi-pencil"></i>
              <%= canChangeEmail ? t("settings:email.submit_change_btn") : t("settings:email.submit_add_btn") %>
            </button>
          </div>
          <% } else { %>
            <div class="info-message">
              <i class="bi bi-info-circle"></i>
              <%= t("settings:email.external_provider_info") %>
            </div>
          <% } %>
        </form>
      </div>
      <!-- Personal Info -->
      <div class="profile-tab-content tab-content">
        <header>
          <h3><%= t("settings:personal_info.heading") %></h3>
          <span><%= t("settings:personal_info.sub") %></span>
        </header>
        <form class="profile-form">
          <div class="avatar-container">
            <label class="avatar">
              <input type="file"  id="avatar-input" disabled />
              <div class="avatar-hover hidden">
                <i class="bi bi-upload"></i>
              </div>
              <% if (photoURL) { %>
                <img src="<%= photoURL %>" width="100" alt="<%= t('common:avatar_alt') %>" />
              <% } else { %>
                <i class="bi bi-person-circle"></i>
              <% } %>
            </label>
            <span class="caption hidden">
              <%= t("settings:personal_info.avatar_caption") %>
            </span>
            <span class="error"></span>
          </div>
          <div class="info-fields">
            <div class="fields">
              <label for="full-name"><%= t("settings:personal_info.full_name_label") %></label>
              <div class="field-container full-name-field">
                <div class="field-icon-container">
                  <span class="icon-box">
                    <i class="bi bi-person"></i>
                  </span>
                </div>
                <input
                  type="text"
                  id="full-name"
                  name="full-name"
                  class="input"
                  value="<%= fullName %>"
                  placeholder="<%= t("settings:personal_info.full_name_placeholder") %>"
                  readonly
                />
              </div>

              <label for="uid"><%= t("settings:personal_info.uid_label") %></label>
              <div class="field-container uid-field">
                <div class="field-icon-container">
                  <span class="icon-box">
                    <i class="bi bi-fingerprint"></i>
                  </span>
                </div>
                <input
                  type="text"
                  id="uid"
                  name="uid"
                  class="input"
                  value="<%= userId %>"
                  disabled
                />
              </div>
            </div>
            <div class="action-btns">
              <button type="button" class="blue-btn modify-btn">
                <i class="bi bi-pencil"></i>
                <%= t("settings:personal_info.modify_btn") %>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
