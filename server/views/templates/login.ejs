<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script nonce="<%= nonce %>">
      (function () {
        try {
          var theme = localStorage.getItem("theme") || "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title><%= t('login:metadata.page_title') %></title>
    <meta
      name="description"
      content="<%= t('login:metadata.meta_description') %>"
    />
    <meta
      name="keywords"
      content="<%= t('login:metadata.keywords', { defaultValue: 'StudySyncro, login, online learning, real-time chat, quizzes, student collaboration' }) %>"
    />
    <meta name="author" content="StudySyncro Team" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="<%= fullUrl %>" />

    <!-- Internationalization (i18n) SEO -->
    <link rel="alternate" hreflang="en" href="<%= baseUrl %><%= fullUrl.split('?')[0].replace(baseUrl, '') %>?lang=en" />
    <link rel="alternate" hreflang="ar" href="<%= baseUrl %><%= fullUrl.split('?')[0].replace(baseUrl, '') %>?lang=ar" />
    <link rel="alternate" hreflang="x-default" href="<%= baseUrl %><%= fullUrl.split('?')[0].replace(baseUrl, '') %>" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:site_name" content="StudySyncro" />
    <meta property="og:locale" content="<%= lang === 'ar' ? 'ar_AR' : 'en_US' %>" />
    <meta property="og:title" content="<%= t('login:metadata.page_title') %>" />
    <meta
      property="og:description"
      content="<%= t('login:metadata.meta_description') %>"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= fullUrl %>" />
    <meta
      property="og:image"
      content="/images/home/active-home-page-light.webp"
    />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= t('login:metadata.page_title') %>" />
    <meta
      name="twitter:description"
      content="<%= t('login:metadata.meta_description') %>"
    />
    <meta
      name="twitter:image"
      content="/images/home/active-home-page-light.webp"
    />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Favicon and Theme -->
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="theme-color" content="#9235e8ff" />
    <meta name="application-name" content="StudySyncro" />
    <!-- Performance Optimization -->
    <link
      rel="preconnect"
      href="https://leaning-11c1d-default-rtdb.firebaseio.com"
    />
    <link
      rel="dns-prefetch"
      href="https://leaning-11c1d-default-rtdb.firebaseio.com"
    />
    <!-- Preloading Critical Resources -->
    <link
      rel="modulepreload"
      href="/login/assets/js/main.mjs"
      as="script"
      crossorigin="anonymous"
    />
    <!-- Google One Tap Script -->
    <script defer nonce="<%= nonce %>" src="https://accounts.google.com/gsi/client"></script>
    <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" as="style" id="font-arabic-preload" />
    <% } %>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" as="style" id="font-inter-preload" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" as="style" id="font-icons-preload" />
    <script nonce="<%= nonce %>">
      document.getElementById('font-inter-preload').rel = 'stylesheet';
      document.getElementById('font-icons-preload').rel = 'stylesheet';
      const arabicFont = document.getElementById('font-arabic-preload');
      if (arabicFont) arabicFont.rel = 'stylesheet';
    </script>
    <noscript>
      <% if (typeof lang !== 'undefined' && lang === 'ar') { %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@200;300;400;500;700;800;900&display=swap" id="font-arabic" />
      <% } %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" id="font-inter" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    </noscript>
    <link rel="stylesheet" href="/main_assets/css/variables_and_fonts.css" />
    <link rel="stylesheet" href="/main_assets/css/styles.css" />
    <link id="stylesheet" rel="stylesheet" href="/login/assets/css/style.css" />
  </head>
  <body>
    <div class="top-nav-bar">
      <a href="/" class="login-top-logo button exclude-btn">
        <img src="/images/logo-mark.svg" alt="<%= t('common:images.logo_alt', { defaultValue: 'StudySyncro Logo' }) %>" />
        <span>StudySyncro</span>
      </a>
      <div>
        <a
          href="/"
          class="button exclude-btn home-link-btn"
          title="<%= t('login:nav.back_to_home') %>"
          aria-label="Back to Home"
        >
          <i class="bi bi-house-door-fill"></i>
          <span><%= t('common:titles.home') %></span>
        </a>
        <button
          class="button exclude-btn toggle-theme-btn"
          id="theme-toggle-btn"
          title="<%= t('common:shared_terms.toggle_dark_light_mode') %>"
          aria-label="Toggle Dark or Light Mode"
        >
          <i class="bi bi-sun theme-toggle-icon" id="theme-toggle-icon"></i>
        </button>
        <button
          class="button exclude-btn lang-toggle-btn"
          title="<%= lang === 'ar' ? t('shared:actions.switch_to_en') : t('shared:actions.switch_to_ar') %>"
          aria-label="Switch Language"
          data-target="<%= lang === 'ar' ? 'en' : 'ar' %>"
        >
          <i class="bi bi-globe"></i>
          <span class="lang-toggle-text"><%= lang === 'ar' ? 'EN' : 'AR' %></span>
        </button>
      </div>
    </div>
    <main>
      <div id="space-reserver"></div>
      <div id="login-form">
        <div id="outline-container"></div>
        <aside>
          <section>
            <h1 style="margin: 0"><%= t('login:aside.welcome_title') %></h1>
            <p><%= t('login:aside.welcome_desc') %></p>
          </section>
          <label id="avatar-container">
            <div>
              <img src="/login/assets/images/user.webp" alt="<%= t('common:avatar_alt') %>" />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-upload"
                viewBox="0 0 16 16"
              >
                <path
                  d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"
                />
                <path
                  id="arrow"
                  d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708z"
                />
              </svg>
            </div>
            <input
              type="file"
              id="avatar-input"
              accept="image/png, image/jpeg, image/jpg, image/webp"
            />
            <div class="text">
              <p><%= t('login:aside.drop_file') %></p>
              <p><%= t('login:aside.allowed_types') %></p>
              <p><%= t('login:aside.file_formats') %></p>
              <p><%= t('login:aside.max_size') %></p>
            </div>
            <span class="error"></span>
          </label>
          <button type="button" id="clear-avatar-btn" class="exclude-btn" style="display: none;">
            <i class="bi bi-trash3-fill"></i>
            <span><%= t('login:aside.remove_avatar', { defaultValue: 'Remove Avatar' }) %></span>
          </button>
        </aside>
        <header>
          <h1>
            <span><%= t('common:shared_terms.login_to') %></span>
            <span id="header-account-text"><%= t('login:header.your_account') %></span>
          </h1>
        </header>
        <section id="forms">
          <div class="sign-in-container active-form">
            <form id="sign-in-form">
              <div class="email-container">
                <div class="md-email-container">
                  <div>
                    <i class="bi bi-envelope-at-fill"></i>
                  </div>
                  <div class="email-container-label">
                    <label for="sign-in-email">
                      <div></div>
                      <span><%= t('common:shared_terms.email') %></span>
                    </label>
                    <input
                      placeholder=""
                      inputmode="email"
                      class="email"
                      type="email"
                      id="sign-in-email"
                      required
                    />
                  </div>
                </div>
                <div class="error-container">
                  <span class="error-msg"></span>
                </div>
              </div>
              <div class="password-container">
                <a id="forgot-password"><%= t('login:sign_in_form.forgot_password') %></a>
                <div class="md-password-container">
                  <div>
                    <i class="bi bi-lock-fill"></i>
                  </div>
                  <div class="password-container-label">
                    <label for="sign-in-password">
                      <div></div>
                      <span><%= t('common:shared_terms.password') %></span>
                    </label>
                    <input
                      placeholder=""
                      class="password"
                      type="password"
                      id="sign-in-password"
                      required
                      autocomplete="off"
                    />
                    <div class="eye-icon">
                      <i class="bi bi-eye-fill"></i>
                      <div>
                        <hr />
                      </div>
                    </div>
                  </div>
                </div>
                <div class="error-container">
                  <span class="error-msg"></span>
                </div>
              </div>
              <button id="sign-in-btn" type="button"><%= t('common:shared_terms.sign_in') %></button>
            </form>
            <p>
              <span><%= t('login:sign_in_form.new_to_studysyncro') %></span>
              <a id="sign-up-link"><%= t('login:sign_in_form.create_account_link') %></a>
            </p>
          </div>
          <div class="sign-up-container">
            <form id="sign-up-form">
              <div class="user-name-container">
                <div>
                  <div class="text-container">
                    <div class="md-text-container">
                      <div>
                        <i class="bi bi-info-circle-fill"></i>
                      </div>
                      <div class="text-container-label">
                        <label for="first-name">
                          <div></div>
                          <span><%= t('login:sign_up_form.first_name_label') %></span>
                        </label>
                        <input
                          placeholder=""
                          type="text"
                          id="first-name"
                          maxlength="50"
                          required
                        />
                      </div>
                    </div>
                  </div>
                  <div class="text-container">
                    <div class="md-text-container">
                      <div>
                        <i class="bi bi-info-circle-fill"></i>
                      </div>
                      <div class="text-container-label">
                        <label for="last-name">
                          <div></div>
                          <span><%= t('login:sign_up_form.last_name_label') %></span>
                        </label>
                        <input
                          placeholder=""
                          type="text"
                          id="last-name"
                          maxlength="50"
                          required
                        />
                      </div>
                    </div>
                  </div>
                </div>
                <div class="error-container">
                  <span class="error-msg"></span>
                </div>
              </div>
              <div class="email-container">
                <div class="md-email-container">
                  <div>
                    <i class="bi bi-envelope-at-fill"></i>
                  </div>
                  <div class="email-container-label">
                    <label for="sign-up-email">
                      <div></div>
                      <span><%= t('common:shared_terms.email') %></span>
                    </label>
                    <input
                      placeholder=""
                      inputmode="email"
                      type="email"
                      id="sign-up-email"
                      required
                    />
                  </div>
                </div>
                <div class="error-container">
                  <span class="error-msg"></span>
                </div>
              </div>
              <div class="password-container">
                <div class="md-password-container">
                  <div>
                    <i class="bi bi-lock-fill"></i>
                  </div>
                  <div class="password-container-label">
                    <label for="sign-up-password">
                      <div></div>
                      <span><%= t('common:shared_terms.password') %></span>
                    </label>
                    <input
                      placeholder=""
                      type="password"
                      class="password"
                      id="sign-up-password"
                      required
                      autocomplete="off"
                    />
                    <div class="eye-icon">
                      <i class="bi bi-eye-fill"></i>
                      <div>
                        <hr />
                      </div>
                    </div>
                  </div>
                </div>
                <div class="error-container">
                  <span class="error-msg"></span>
                </div>
              </div>
              <div class="password-container">
                <div class="md-password-container">
                  <div>
                    <i class="bi bi-lock-fill"></i>
                  </div>
                  <div class="password-container-label">
                    <label for="confirm-password">
                      <div></div>
                      <span><%= t('common:shared_terms.confirm_password') %></span>
                    </label>
                    <input
                      placeholder=""
                      type="password"
                      class="password"
                      id="confirm-password"
                      required
                      autocomplete="off"
                    />
                    <div class="eye-icon">
                      <i class="bi bi-eye-fill"></i>
                      <div>
                        <hr />
                      </div>
                    </div>
                  </div>
                </div>
                <div class="error-container">
                  <span class="error-msg"></span>
                </div>
              </div>
              <button id="sign-up-btn" type="button"><%= t('login:sign_up_form.sign_up_btn') %></button>
            </form>
            <p>
              <span><%= t('login:sign_up_form.already_have_account') %></span>
              <a id="sign-in-link"><%= t('common:shared_terms.sign_in') %></a>
            </p>
          </div>
        </section>
        <div class="separator">
          <hr />
          <p><%= t('common:shared_terms.or') %></p>
        </div>
        <section class="provider-container">
          <button
            type="button"
            id="google-sign-in"
            class="provider"
            title="<%= t('login:providers.google_sign_in') %>"
          >
            <svg
              width="256"
              height="262"
              viewBox="0 0 256 262"
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid"
            >
              <path
                d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"
                fill="#4285F4"
              />
              <path
                d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"
                fill="#34A853"
              />
              <path
                d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782"
                fill="#FBBC05"
              />
              <path
                d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"
                fill="#EB4335"
              />
            </svg>
            <span><%= t('login:providers.google_sign_in') %></span>
          </button>
          <button
            type="button"
            id="fb-sign-in"
            class="provider"
            title="<%= t('login:providers.facebook_sign_in') %>"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 36 36"
              fill="url(#a)"
              height="40"
              width="40"
            >
              <defs>
                <linearGradient x1="50%" x2="50%" y1="97.078%" y2="0%" id="a">
                  <stop offset="0%" stop-color="#0062E0" />
                  <stop offset="100%" stop-color="#19AFFF" />
                </linearGradient>
              </defs>
              <path
                d="M15 35.8C6.5 34.3 0 26.9 0 18 0 8.1 8.1 0 18 0s18 8.1 18 18c0 8.9-6.5 16.3-15 17.8l-1-.8h-4l-1 .8z"
              />
              <path
                fill="#FFF"
                d="m25 23 .8-5H21v-3.5c0-1.4.5-2.5 2.7-2.5H26V7.4c-1.3-.2-2.7-.4-4-.4-4.1 0-7 2.5-7 7v4h-4.5v5H15v12.7c1 .2 2 .3 3 .3s2-.1 3-.3V23h4z"
              />
            </svg>
            <span><%= t('login:providers.facebook_sign_in') %></span>
          </button>
        </section>
      </div>
    </main>
    <script
      type="module"
      nonce="<%= nonce %>"
      src="/login/assets/js/main.mjs"
      crossorigin="anonymous"
    ></script>
    <script
      type="module"
      nonce="<%= nonce %>"
      src="/login/assets/js/auth/auth-functions.mjs"
      crossorigin="anonymous"
    ></script>
  </body>
</html>

